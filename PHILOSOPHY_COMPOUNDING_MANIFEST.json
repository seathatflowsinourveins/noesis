      ],
      "progressive_profit_lock_tiers": [
        {"tier": 1, "name": "BE_PLUS_FEE", "trigger": "initial_favorable_excursion", "floor": "breakeven_plus_fee"},
        {"tier": 2, "name": "LOCK_AT_1R", "trigger": "+1.0R", "floor": "+0.45R"},
