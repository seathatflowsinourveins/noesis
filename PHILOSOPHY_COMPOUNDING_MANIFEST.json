  "core_trading_philosophy": {
    "extreme_movers_early": {
      "objective": "Focus capital and broker API rate budgets strictly on the highest-potential extreme movers early (including FINRA TRF Exchange.D institutional darkpool block/carryover and unusual-volume buildup) while filtering out flat, low-RVOL mega-caps.",
      "default_pins": ["SOXL", "SOXS", "TQQQ", "SQQQ"],
      "excluded_hold_reasons": ["LOW_MOVE_NOT_EXTREME", "LOW_RVOL_NOT_EXTREME"],
      "realization_modules": [
        "src/tier0_sota/live/scanner.py",
        "src/tier0_sota/tv/tickets.py",
        "src/tier0_sota/discovery.py"
      ]
    },
    "causal_market_regime_alignment": {
      "objective": "Align long/short direction with causal multi-feed market regime (SPY, QQQ, SOXX, RSP, VIX); short market crashes (regime == -1) and short peaks only after E2E-verified causal reversal confirmation.",
      "short_routing": {
        "easy_to_borrow": "DIRECT_SHORT_ETB",
        "hard_to_borrow_or_unverified": "INVERSE_HEDGE_SOXS_SQQQ",
        "inverse_hedges": ["SOXS", "SQQQ", "SPXS", "SDOW"]
      },
      "prewall_pit_cutoff": "2026-10-15",
      "causal_bar_lag_secs": 60,
      "calendar": "XNYS"
    },
    "session_24x5_protection_and_velocity": {
      "sessions": {
        "PRE_MARKET": {
          "order_mode": "STOP_LIMIT",
          "outside_rth": true,
          "limit_collar_bps": 35
        },
        "RTH": {
          "order_mode": "STOP_MARKET",
          "outside_rth": false,
          "limit_collar_bps": 0
        },
        "AFTER_HOURS": {
