{
  "uid": "tier0-sota-obs",
  "title": "Tier-0 SOTA — Prometheus & OTel Observability",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Observability Exporter Health",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [{"expr": "up{job=\"tier0_sota_telemetry\"}", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Daily -1.50% Breaker Latched",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [{"expr": "tier0_drawdown_breaker_latched", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Prometheus Scrape Targets Up",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [{"expr": "up", "legendFormat": "Target Up ({{job}})", "refId": "A"}]
    }
  ]
}
