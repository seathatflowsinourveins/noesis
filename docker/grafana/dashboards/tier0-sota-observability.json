{
  "uid": "tier0-sota-obs",
  "title": "Tier-0 SOTA — Prometheus & OTel Observability",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "15s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Observability Exporter Health",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [{"expr": "min(up{instance=\"telemetry-exporter:9464\", exported_job=\"\"})", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Daily -1.50% Breaker Latched",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [{"expr": "max(tier0_drawdown_breaker_latched) or vector(0)", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Combined Paper Farm Equity (USD)",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD", "decimals": 2},
        "overrides": []
      },
      "targets": [
        {
          "expr": "tier0_paper_farm_combined_equity_usd",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Causal Macro Regime (-1 Crash / 0 Neutral / +1 Bull)",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [{"expr": "tier0_scanner_macro_regime", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "TV Half-Auto Tickets, Standby, Staged & DuckDB Audit",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [
        {"expr": "tier0_tv_half_auto_tickets_count", "legendFormat": "Active Tickets", "refId": "A"},
        {"expr": "tier0_tv_half_auto_ready_tickets_count", "legendFormat": "Ready Half-Auto", "refId": "B"},
        {"expr": "tier0_tv_half_auto_standby_presets_count", "legendFormat": "Standby Presets", "refId": "C"},
        {"expr": "tier0_tv_half_auto_staged_presets_count", "legendFormat": "Staged Presets", "refId": "D"},
        {"expr": "tier0_tv_half_auto_duckdb_audit_rows", "legendFormat": "DuckDB Audit Rows", "refId": "E"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Whole-Market Scanner, FINRA TRF Darkpool & Unusual Volume",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [
        {"expr": "tier0_scanner_ranked_count", "legendFormat": "Ranked Movers", "refId": "A"},
        {"expr": "tier0_scanner_extreme_eligible_count", "legendFormat": "Extreme Eligible", "refId": "B"},
        {"expr": "tier0_tv_half_auto_unusual_vol_count", "legendFormat": "Unusual Vol Buildup", "refId": "C"},
        {"expr": "tier0_tv_half_auto_darkpool_hits_count", "legendFormat": "FINRA TRF Darkpool Hits", "refId": "D"},
        {"expr": "tier0_tv_half_auto_darkpool_trf_covered_count", "legendFormat": "TRF Covered Symbols", "refId": "E"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Paper Farm TCA IS (bps) & 24/5 Extended-Hours Protection",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [
        {
          "expr": "tier0_paper_farm_combined_tca_mean_is_bps",
          "legendFormat": "Combined Mean IS (bps)",
          "refId": "A"
        },
        {
          "expr": "tier0_paper_farm_combined_tca_p95_is_bps",
          "legendFormat": "Combined P95 IS (bps)",
          "refId": "B"
        },
        {
          "expr": "tier0_paper_farm_combined_extended_hours_protected_ratio",
          "legendFormat": "24/5 Ext-Hours Protected Ratio",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Prometheus Scrape Targets Up",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [{"expr": "up{exported_job=\"\"}", "legendFormat": "Target Up ({{job}})", "refId": "A"}]
    }
  ]
}
