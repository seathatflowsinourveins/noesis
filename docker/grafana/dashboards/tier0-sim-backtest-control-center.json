{
  "uid": "tier0-sim-backtest-control-center",
  "title": "Tier-0 SOTA — Sim-Backtest, Falsification & Upstream Control Center",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "timezone": "browser",
  "tags": ["tier0", "sim-backtest", "falsification", "control-center"],
  "panels": [
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sim-vs-Paper TCA Cost Envelope (Liquid >=$10 Order & Notional-Weighted IS bps)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "bps", "decimals": 2},
        "overrides": []
      },
      "targets": [
        {
          "expr": "tier0_paper_farm_combined_tca_liquid_ge10_order_mean_is_bps",
          "legendFormat": "Liquid >=$10 Order-Mean IS (bps)",
          "refId": "A"
        },
        {
          "expr": "tier0_paper_farm_combined_tca_liquid_ge10_notional_weighted_is_bps",
          "legendFormat": "Liquid >=$10 Notional-Weighted IS (bps)",
          "refId": "B"
        },
        {
          "expr": "tier0_paper_farm_combined_tca_order_mean_is_bps",
          "legendFormat": "All-Fills Order-Mean IS (bps)",
          "refId": "C"
        },
        {
          "expr": "tier0_paper_farm_combined_tca_p95_is_bps",
          "legendFormat": "Combined P95 IS (bps)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "24/5 Lossless Risk Guardrails & Drawdown Breaker",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [
        {
          "expr": "tier0_drawdown_breaker_latched",
          "legendFormat": "Daily -1.50% Breaker Latched",
          "refId": "A"
        },
        {
          "expr": "tier0_paper_farm_combined_extended_hours_protected_ratio",
          "legendFormat": "24/5 Ext-Hours Protected Ratio",
          "refId": "B"
        },
        {
          "expr": "tier0_paper_farm_combined_submitted_vs_filled_ratio",
          "legendFormat": "Submitted vs Filled Ratio",
          "refId": "C"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream Control Center Scrape Targets Health",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "tier0-prometheus"},
      "targets": [
        {
          "expr": "up{exported_job=\"\"}",
          "legendFormat": "Up: {{job}} ({{instance}})",
          "refId": "A"
        }
      ]
    }
  ]
}
