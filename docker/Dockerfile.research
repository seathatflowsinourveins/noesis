FROM python:3.13.3-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends curl git libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory /workspace
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /usr/local/bin/uv

WORKDIR /workspace
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/workspace/src:/workspace"

COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-group dev \
    && groupadd --gid 1000 sota \
    && useradd --create-home --uid 1000 --gid 1000 sota \
    && chown -R 1000:1000 /opt/venv /workspace

ENV OMP_NUM_THREADS=4 \
    OPENBLAS_NUM_THREADS=4 \
    MKL_NUM_THREADS=4 \
    NUMEXPR_NUM_THREADS=4 \
    BLIS_NUM_THREADS=4 \
    POLARS_MAX_THREADS=4 \
    RAYON_NUM_THREADS=4 \
    TOKENIZERS_PARALLELISM=false \
    MLFLOW_DISABLE_AGENT_HINT=1

HEALTHCHECK --interval=60s --timeout=5s --retries=3 CMD test -x /opt/venv/bin/python || exit 1

USER sota
