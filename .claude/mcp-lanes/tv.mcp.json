{
  "mcpServers": {
    "nautilus-engine": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--no-sync", "python", "scripts/nautilus_mcp_server.py"]
    },
    "xerj": {
      "type": "stdio",
      "command": "xerj",
      "args": ["mcp"],
      "env": {"XERJ_URL": "http://127.0.0.1:9200", "XERJ_DISABLE_FEEDBACK": "true"}
    }
  }
}
