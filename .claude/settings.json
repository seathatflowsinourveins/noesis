{
  "teammateMode": "in-process",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "0",
    "XERJ_URL": "http://127.0.0.1:9200",
    "XERJ_DISABLE_FEEDBACK": "true",
    "MLFLOW_TRACKING_URI": "http://127.0.0.1:5000"
  },
  "mcpServers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": []
    },
    "xerj": {
      "type": "stdio",
      "command": "xerj",
      "args": [
        "mcp"
      ],
      "env": {
        "XERJ_URL": "http://127.0.0.1:9200",
        "XERJ_DISABLE_FEEDBACK": "true"
      }
    },
    "nautilus-engine": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "python",
        "scripts/nautilus_mcp_server.py"
      ]
    },
    "edgartools": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "edgartools-mcp"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Edit(~/Documents/upstream/**)",
      "Read(~/Documents/upstream/.git/**)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.config/tier0/**)",
      "Edit(/src/tier0_sota/risk.py)",
      "Edit(./src/tier0_sota/risk.py)",
      "mcp__alpaca-live__*",
      "mcp__*alpaca*live*__*",
      "Bash(*api.alpaca.markets*)",
      "Bash(*:4001*)",
      "Bash(*:7496*)",
      "Bash(*:8798*)",
      "Bash(*:8796*)",
      "Bash(*wsl --shutdown*)",
      "Bash(*wsl*--unregister*)",
      "Bash(*wsl*--terminate*)",
      "Bash(*git*push*--force*)",
      "Bash(*git*push* -f*)",
      "Bash(*--no-verify*)",
      "PowerShell(*api.alpaca.markets*)",
      "PowerShell(*:4001*)",
      "PowerShell(*:7496*)",
      "PowerShell(*:8798*)",
      "PowerShell(*:8796*)",
      "PowerShell(*wsl --shutdown*)",
      "PowerShell(*wsl*--unregister*)",
      "PowerShell(*wsl*--terminate*)",
      "PowerShell(*git*push*--force*)",
      "PowerShell(*git*push* -f*)",
      "PowerShell(*--no-verify*)"
    ]
  }
}
