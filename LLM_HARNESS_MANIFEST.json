    "supply_chain_scan": "trivy fs --scanners vuln,secret,misconfig --severity HIGH,CRITICAL --exit-code 1 --skip-dirs .venv,.git,site,.claude/skills,.cache,.ruff_cache,.pytest_cache,.hypothesis .",
    "secret_scan": "gitleaks detect --no-git --source . --config .gitleaks.toml --no-banner",
    "windows_ci_gate": "pwsh -NoProfile -File scripts/check.ps1",
    "wsl2_ci_gate": "bash scripts/check.sh",
    "grand_reset_verify": "pwsh -NoProfile -File scripts/grand_reset/verify_grand_reset.ps1"
  }
}
