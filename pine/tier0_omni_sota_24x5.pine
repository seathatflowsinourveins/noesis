//@version=6
indicator("Tier-0 Omni SOTA 24x5 Lossless, Auto-Reverse & Regime", shorttitle="T0_OMNI_SOTA", overlay=true, max_bars_back=500, max_lines_count=200, max_labels_count=200)

import TradingView/ta/10 as tvta
import TradingView/TechnicalRating/3 as tvtr

// ============================================================================
// Tier-0 SOTA — Omni 24/5 Display, Lossless Trailing, UV/Darkpool & Order HUD
// Official Upstreams: TradingView/ta/10 (STD;Relative%1Volume%1at%1Time, STD;UP_DOWN_Volume),
//                     TradingView/TechnicalRating/3 (STD;Technical%1Ratings), STD;VWAP v48.0
// Parity: src/tier0_sota/engine.py & src/tier0_sota/risk.py (Rule-612 <= 2.00% cap)
//         1000rpm/3000rpm Venue Order Handles (IBKR_PAPER_4002 / ALPACA_PAPER_1000 / ALPACA_PAPER_200)
// Compliance: Display-only Pine v6 + tier0.tv-alert.v1 JSON (semi_auto_confirmed=false, qty=1)
// Non-Repainting: barstate.isconfirmed + gaps=barmerge.gaps_off + lookahead=barmerge.lookahead_off
// ============================================================================

// ── 0. Pine v6 UDTs (Venue Order Handles & Native TV Order Preset Card) ─────
type VenueOrderHandle
    string profile_id
    string broker
    string env_tag
    int    max_rpm
    int    max_rps
    int    exit_reserve_rpm
    int    entry_modify_rpm
    int    max_trailed_pos
    float  cadence_secs
    bool   is_stage5_parity

type OrderPresetCard
    bool   is_live_leg
    string side
    string route_mode
    string order_type
    string tif
    int    collar_bps
    float  entry_px
    float  entry_limit
    float  stop_px
    float  stop_limit
    float  stop_pct
    float  be_floor
    float  t1r
    float  l1r
    float  t2r
    float  l2r
    float  t3r
    float  l3r
    float  fast_rev
    int    sh_25k
    int    sh_100k

// ── 1. Omni Use-Case Preset, Venue Order-Handle & Market Regime Tuning ──────
grp_omni = "01 · Omni Use-Case, Venue Handle & Market Tuning"
i_omni_preset = input.string(
    "AUTO_REGIME_ADAPTIVE",
    "Omni SOTA Preset Mode",
    options=[
        "AUTO_REGIME_ADAPTIVE",
        "LOSSLESS_TIGHT_SCALP",
        "CRASH_DEFENSIVE_INVERSE",
        "MINERVINI_VCP_BREAKOUT",
        "STOCKBEE_EP_MOMENTUM_BURST",
        "STOCKBEE_EXHAUSTION_HAMMER",
        "PARABOLIC_EXHAUSTION_SHORT",
        "OVERNIGHT_24X5_IBKR"
    ],
    group=grp_omni
)
i_venue_profile = input.string(
    "IBKR_PAPER_4002",
    "Venue Order-Handle Profile (1000rpm/3000rpm)",
    options=[
        "IBKR_PAPER_4002",
        "ALPACA_PAPER_1000",
        "ALPACA_PAPER_200",
        "ALPACA_LIVE_PRO_LINE_1000",
        "IBKR_LIVE_3000",
        "ALPACA_LIVE_ELITE_SMART_ROUTER"
    ],
    group=grp_omni
)
i_etb_short        = input.bool(true, "Symbol Shortable & Easy-To-Borrow (ETB)", group=grp_omni)
i_early_close_1300 = input.bool(false, "XNYS Half-Day Early Close (13:00 ET RTH End)", group=grp_omni)
i_use_mkt_reg      = input.bool(true, "Enforce Causal Multi-Feed Market Regime", group=grp_omni)
i_vix_def          = input.float(25.0, "VIX Crash-Defensive Threshold", minval=15.0, maxval=60.0, step=0.5, group=grp_omni)
i_mkt_sym          = input.string("AMEX:SPY", "Broad Market Regime Feed", group=grp_omni)
i_qqq_sym          = input.string("NASDAQ:QQQ", "Growth / Nasdaq Regime Feed", group=grp_omni)
i_semi_sym         = input.string("NASDAQ:SOXX", "Semiconductor Regime Feed", group=grp_omni)
i_rsp_sym          = input.string("AMEX:RSP", "Equal-Weight Breadth Feed", group=grp_omni)
i_vix_sym          = input.string("TVC:VIX", "Volatility Regime Feed (VIX)", group=grp_omni)

// ── 2. Lossless Trailing, Auto-Reverse & Re-Entry FSM Controls ──────────────
grp_fsm = "02 · Lossless Trailing, Auto-Reverse & Re-Entry"
i_sched_ovr     = input.string("AUTO_NATR", "Display Trailing Schedule (Bridge Enforces AUTO_NATR)", options=["AUTO_NATR", "tight_near_lossless", "baseline", "wide_natr_adaptive"], group=grp_fsm)
i_fee_bps_side  = input.float(4.0, "Est Fee/Slippage (bps/side)", minval=0.0, maxval=25.0, step=0.5, group=grp_fsm)
i_spread_bps    = input.float(2.0, "Spread Buffer (bps)", minval=0.0, maxval=20.0, step=0.5, group=grp_fsm)
i_est_spread_bps = input.float(5.0, "Est Spread for Non-Noise Min-Trail (bps)", minval=0.0, maxval=50.0, step=0.5, group=grp_fsm)
i_use_nn_trail  = input.bool(true, "Enforce Per-Symbol Non-Noise Min-Trail Floor", group=grp_fsm)
i_use_fast_be   = input.bool(false, "Cap BE Trigger with Fast Override (Off = Exact Engine Parity)", group=grp_fsm)
i_fast_be_pct   = input.float(0.20, "Fast Lossless BE Trigger (%)", minval=0.10, maxval=1.00, step=0.05, group=grp_fsm)
i_prog_lock     = input.bool(true, "Enable 4-Tier Progressive R-Lock (+1R/+2R/+3R)", group=grp_fsm)
i_fast_sell_rev = input.bool(true, "Enable Fast-Sell Climax + Auto-Reverse Short", group=grp_fsm)
i_auto_reverse  = input.bool(true, "Enable Flatten-First Auto-Reverse", group=grp_fsm)
i_auto_reentry  = input.bool(true, "Enable Seamless Auto Re-Entry", group=grp_fsm)
i_cooldown_sec  = input.int(60, "Re-Entry Cooldown (sec)", minval=60, maxval=3600, step=60, group=grp_fsm)
i_show_rungs    = input.bool(true, "Plot Lossless BE + 1R/2R/3R Profit Rungs", group=grp_fsm)
i_show_vwap_bnd = input.bool(true, "Plot Session VWAP +/-1s & +/-2s Darkpool Bands", group=grp_fsm)

// ── 3. Unusual Volume, Darkpool Proxy & Setup Thresholds ────────────────────
grp_sig = "03 · SOTA Setup, Unusual Volume & Darkpool Proxy"
i_rvol_len      = input.int(20, "Relative Volume Lookback", minval=5, maxval=100, group=grp_sig)
i_rvol_base     = input.float(1.5, "Base Min RVOL", minval=1.0, maxval=10.0, step=0.1, group=grp_sig)
i_ext_mult      = input.float(2.0, "Extreme Move ATR Multiple", minval=1.0, maxval=5.0, step=0.25, group=grp_sig)
i_uv_z_min      = input.float(2.0, "Unusual Volume Z-Score Min", minval=1.0, maxval=6.0, step=0.25, group=grp_sig)
i_uv_vel_min    = input.float(1.8, "3-Bar Volume Velocity Min", minval=1.1, maxval=5.0, step=0.1, group=grp_sig)
i_pre_ign_en    = input.bool(true, "Enable Premarket Early Ignition (04:00-09:30 ET)", group=grp_sig)
i_show_diag     = input.bool(true, "Show Institutional SOTA Status HUD (Top-Right)", group=grp_sig)
i_show_ord_hud  = input.bool(true, "Show Copy-Ready Native TV Order Preset HUD (Bottom-Right)", group=grp_sig)
i_show_mtf      = input.bool(true, "Show MTF (1m/5m/15m/D) Alignment Row", group=grp_sig)
i_show_bg       = input.bool(true, "Show Subtle Regime / VCP Background Tint", group=grp_sig)

// ── 3b. Venue Order-Handle Resolver (Exact Engine Parity: >=10% Exit Reserve) ─
resolve_venue_handle(string vp) =>
    bool is_ibkr = vp == "IBKR_PAPER_4002" or vp == "IBKR_LIVE_3000"
    bool is_alp_200 = vp == "ALPACA_PAPER_200"
    bool is_stage5 = vp == "ALPACA_LIVE_PRO_LINE_1000" or vp == "IBKR_LIVE_3000" or vp == "ALPACA_LIVE_ELITE_SMART_ROUTER"
    int max_rpm = is_ibkr ? 3000 : is_alp_200 ? 200 : 1000
    int max_rps = is_ibkr ? 50 : is_alp_200 ? 10 : 25
    int exit_res = math.max(1, math.ceil(max_rpm * 0.10))
    int entry_rpm = max_rpm - exit_res
    int max_pos = is_ibkr ? 20 : is_alp_200 ? 3 : 10
    float cadence = math.max(1.0, math.round((120.0 * max_pos) / math.max(1.0, entry_rpm), 2))
    VenueOrderHandle.new(
        vp,
        is_ibkr ? "IBKR" : "ALPACA",
        is_stage5 ? "STAGE5_PARITY" : "PAPER",
        max_rpm,
        max_rps,
        exit_res,
        entry_rpm,
        max_pos,
        cadence,
        is_stage5
    )

VenueOrderHandle vh = resolve_venue_handle(i_venue_profile)

// ── 4. Causal 24/5 America/New_York Session Classification ──────────────────
ny_hour      = hour(time_close, "America/New_York")
ny_min       = minute(time_close, "America/New_York")
ny_dow       = dayofweek(time_close, "America/New_York")
ny_mins      = ny_hour * 60 + ny_min
rth_end_mins = i_early_close_1300 ? 780 : 960

is_rth       = ny_mins >= 570 and ny_mins < rth_end_mins
is_pre       = ny_mins >= 240 and ny_mins < 570
is_after     = ny_mins >= rth_end_mins and ny_mins < 1200
is_24x5_open = (ny_dow >= dayofweek.monday and ny_dow <= dayofweek.thursday) or (ny_dow == dayofweek.friday and ny_mins < 1200) or (ny_dow == dayofweek.sunday and ny_mins >= 1200)
is_ext       = is_pre or is_after

sess_label = not is_24x5_open ? "CLOSED" : is_rth ? "RTH" : is_pre ? "PRE_MARKET" : is_after ? "AFTER_HOURS" : "OVERNIGHT"
order_type = is_rth ? "STOP_MARKET" : "STOP_LIMIT"
collar_bps = is_rth ? 0 : is_ext ? 35 : 50
sess_exec_mech   = not is_24x5_open ? "SESSION_CLOSED_HOLD_GTC_STOP" : is_rth ? "NATIVE_BROKER_STOP_MARKET_RATCHET" : is_ext ? "SYNTHETIC_TICK_SUPERVISED_COLLARED_LIMIT" : "SYNTHETIC_BOATS_COLLARED_LIMIT"
sess_order_badge = not is_24x5_open ? "CLOSED · HOLD_GTC_STOP" : is_rth ? "RTH STOP_MARKET 0bp (Native Ratchet)" : is_ext ? (is_pre ? "PRE " : "AH ") + "35bp SYNTHETIC_COLLARED_LIMIT" : "OVERNIGHT 50bp SYNTHETIC_COLLARED_LIMIT"
sess_noise_bps   = is_rth ? 0.0 : is_ext ? 5.0 : 10.0

// ── 5. Reg-NMS Rule-612 Tick Quantization & Collared Limits (Exact Parity) ──
rule612_tick(float px) =>
    px >= 1.0 ? 0.01 : 0.0001

inward_stop(float px, int side) =>
    float safe_px = math.max(0.0001, px)
    float tick = rule612_tick(safe_px)
    float ticks = math.round(safe_px / tick, 10)
    math.max(0.0001, math.round((side == 1 ? math.ceil(ticks) : math.floor(ticks)) * tick, 4))

outward_limit(float px, int side) =>
    float safe_px = math.max(0.0001, px)
    float tick = rule612_tick(safe_px)
    float ticks = math.round(safe_px / tick, 10)
    math.max(0.0001, math.round((side == 1 ? math.floor(ticks) : math.ceil(ticks)) * tick, 4))

collared_stop_limit(float stp_px, int side, int c_bps) =>
    float col = c_bps / 10000.0
    outward_limit(stp_px * (1.0 - side * col), side)

collared_entry_limit(float ref_px, int side, int c_bps) =>
    float col = c_bps / 10000.0
    outward_limit(ref_px * (1.0 + side * col), side)

hard_stop(float ref_px, int side, float cap) =>
    int ref_ticks = math.round(ref_px * 10000)
    int cap_bps = math.min(200, math.max(1, math.round(cap * 10000)))
    int numerator = ref_ticks * (10000 - side * cap_bps)
    int raw_ticks = math.max(1, math.floor((numerator + (side == 1 ? 9999 : 0)) / 10000))
    int step_ticks = raw_ticks >= 10000 ? 100 : 1
    int inward_offset = side == 1 ? step_ticks - 1 : 0
    int stop_ticks = math.floor((raw_ticks + inward_offset) / step_ticks) * step_ticks
    if side == 1 and stop_ticks >= ref_ticks
        int back_step = ref_ticks > 10000 ? 100 : 1
        int cand = math.max(1, ref_ticks - back_step)
        int cs = cand >= 10000 ? 100 : 1
        stop_ticks := math.floor((cand + cs - 1) / cs) * cs
    else if side == -1 and stop_ticks <= ref_ticks
        int fwd_step = ref_ticks >= 10000 ? 100 : 1
        int cand = ref_ticks + fwd_step
        int cs = cand >= 10000 ? 100 : 1
        stop_ticks := math.floor(cand / cs) * cs
    int distance = side * (ref_ticks - stop_ticks)
    stop_ticks > 0 and distance > 0 and distance * 10000 <= cap_bps * ref_ticks ? stop_ticks / 10000.0 : na

size_by_risk(float eq, float entry_p, float stop_p, float risk_pct, float max_notl_pct) =>
    float dist = math.abs(entry_p - stop_p)
    if dist <= 0.0 or entry_p <= 0.0
        0
    else
        int by_risk = math.floor((eq * risk_pct) / dist)
        int by_notl = math.floor((eq * max_notl_pct) / entry_p)
        math.max(0, math.min(by_risk, by_notl))

// ── 6. Core Technicals & Wilder NATR Schedule Selection ─────────────────────
i_natr_len = 14
atr_val    = ta.atr(i_natr_len)
natr_pct   = close > 0 ? nz(atr_val, close * 0.015) / close : 0.015
natr_out   = math.min(1.0, math.max(0.000001, math.round(nz(natr_pct, 0.015), 6)))
vol_safe   = nz(volume, 0.0)
vol_sma    = ta.sma(vol_safe, i_rvol_len)
vol_std    = ta.stdev(vol_safe, i_rvol_len)
[tv_cur_vol, tv_past_vol, _] = tvta.relativeVolume(i_rvol_len, "1D", false, false)
rvol       = not na(tv_past_vol) and tv_past_vol > 0 ? tv_cur_vol / tv_past_vol : (vol_sma > 0 ? vol_safe / vol_sma : 1.0)
vol_zscore = vol_std > 0 ? (vol_safe - vol_sma) / vol_std : 0.0
vol_3      = ta.sma(vol_safe, 3)
vol_buildup_ratio = vol_sma > 0 ? math.max(0.0, math.round(vol_3 / vol_sma, 3)) : 1.0
dollar_vol = close * vol_safe

ema_fast   = ta.ema(close, 9)
ema_slow   = ta.ema(close, 21)
ema_50     = ta.ema(close, 50)
[_vwap_s, _vwap_u1_s, _] = ta.vwap(hlc3, timeframe.change("D"), 1.0)
vwap_val    = _vwap_s
vwap_dev_fb = ta.stdev(close - nz(vwap_val, close), 20)
vwap_dev    = not na(_vwap_s) and not na(_vwap_u1_s) ? (_vwap_u1_s - _vwap_s) : vwap_dev_fb
vwap_u1    = not na(vwap_val) and not na(vwap_dev) ? vwap_val + vwap_dev : na
vwap_d1    = not na(vwap_val) and not na(vwap_dev) ? vwap_val - vwap_dev : na
vwap_u2    = not na(vwap_val) and not na(vwap_dev) ? vwap_val + 2.0 * vwap_dev : na
vwap_d2    = not na(vwap_val) and not na(vwap_dev) ? vwap_val - 2.0 * vwap_dev : na
[tv_rating_all, tv_rating_osc, tv_rating_ma] = tvtr.calcRatingAll()
tv_rating_lbl = str.replace_all(tvtr.ratingStatus(tv_rating_all), "\n", " ")

auto_sched   = natr_out <= 0.015 ? "tight_near_lossless" : natr_out <= 0.030 ? "baseline" : "wide_natr_adaptive"
preset_sched = auto_sched
sched_id     = i_sched_ovr == "AUTO_NATR" ? preset_sched : i_sched_ovr

var string leg_schedule = ""
active_schedule = leg_schedule == "" ? sched_id : leg_schedule
is_tight = active_schedule == "tight_near_lossless"
is_base  = active_schedule == "baseline"

sess_init_cap = is_tight ? (is_rth ? 0.0150 : is_ext ? 0.0125 : 0.0100) : (is_rth ? 0.0200 : is_ext ? 0.0150 : 0.0100)
auto_init_cap = auto_sched == "tight_near_lossless" ? (is_rth ? 0.0150 : is_ext ? 0.0125 : 0.0100) : (is_rth ? 0.0200 : is_ext ? 0.0150 : 0.0100)
be_trig_base  = is_tight ? (is_rth ? 0.0025 : is_ext ? 0.0030 : 0.0025) : is_base ? (is_rth ? 0.0040 : is_ext ? 0.0045 : 0.0030) : (is_rth ? 0.0060 : is_ext ? 0.0055 : 0.0040)
be_trig       = i_use_fast_be ? math.min(be_trig_base, i_fast_be_pct / 100.0) : be_trig_base
min_trail_pct = is_tight ? (is_rth ? 0.0025 : is_ext ? 0.0035 : 0.0050) : is_base ? (is_rth ? 0.0035 : is_ext ? 0.0050 : 0.0060) : (is_rth ? 0.0050 : is_ext ? 0.0050 : 0.0060)
natr_mult     = is_tight ? (is_rth ? 1.00 : is_ext ? 1.25 : 1.50) : is_base ? (is_rth ? 1.25 : is_ext ? 1.50 : 1.75) : (is_rth ? 1.50 : is_ext ? 1.50 : 1.75)
trail_pct     = math.min(sess_init_cap, math.max(min_trail_pct, natr_pct * natr_mult))
fee_buf       = (i_fee_bps_side * 2.0 + i_spread_bps) / 10000.0

// ── 7. Multi-Feed Causal Market-Status & Bidirectional Pair Engine ──────────
tkr = str.upper(syminfo.ticker)
is_inverse_etf = tkr == "SOXS" or tkr == "SQQQ" or tkr == "SPXS" or tkr == "SPXU" or tkr == "SH" or tkr == "SDOW" or tkr == "TZA" or tkr == "QID" or tkr == "SDS" or tkr == "TECS" or tkr == "NVDS" or tkr == "TSLS" or tkr == "MSTZ"
is_soxs        = tkr == "SOXS"
is_soxl        = tkr == "SOXL"
is_lev_bull    = is_soxl or tkr == "TQQQ" or tkr == "UPRO" or tkr == "SPXL" or tkr == "TECL" or tkr == "NVDL" or tkr == "TSLL" or tkr == "MSTU"
is_lev_or_inv  = is_inverse_etf or is_lev_bull
pair_sym       = tkr == "SOXL" ? "SOXS" : tkr == "SOXS" ? "SOXL" : tkr == "TQQQ" ? "SQQQ" : tkr == "SQQQ" ? "TQQQ" : tkr == "UPRO" ? "SPXS" : tkr == "SPXS" ? "UPRO" : tkr == "SPXL" ? "SPXS" : tkr == "TECL" ? "TECS" : tkr == "TECS" ? "TECL" : tkr == "NVDL" ? "NVDS" : tkr == "NVDS" ? "NVDL" : tkr == "TSLL" ? "TSLS" : tkr == "TSLS" ? "TSLL" : tkr == "MSTU" ? "MSTZ" : tkr == "MSTZ" ? "MSTU" : ""

is_semi_sym    = is_soxs or is_soxl or tkr == "NVDA" or tkr == "SMH" or tkr == "SOXX" or tkr == "MU" or tkr == "AMD" or tkr == "AVGO" or tkr == "TSM" or tkr == "ASML" or tkr == "MRVL" or tkr == "NVDL" or tkr == "NVDS"
is_qqq_sym     = tkr == "TQQQ" or tkr == "SQQQ" or tkr == "QQQ" or tkr == "QID"
bench_sym      = is_semi_sym ? i_semi_sym : is_qqq_sym ? i_qqq_sym : i_mkt_sym

int htf_idx = barstate.isrealtime ? 1 : 0
[mkt_c, mkt_sma, mkt_vwap, mkt_roc, mkt_close_ts] = request.security(
    bench_sym,
    timeframe.period,
    [close, ta.sma(close, 50), ta.vwap(hlc3), (close - close[15]) / math.max(close[15], syminfo.mintick), time_close],
    gaps=barmerge.gaps_off,
    lookahead=barmerge.lookahead_off,
    ignore_invalid_symbol=true
)
[spy_c, spy_sma] = request.security(i_mkt_sym, "5", [close[htf_idx], ta.sma(close, 50)[htf_idx]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
[rsp_c, rsp_sma] = request.security(i_rsp_sym, "D", [close[htf_idx], ta.sma(close, 20)[htf_idx]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
vix_last         = request.security(i_vix_sym, "15", close[htf_idx], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

mtf_5m_up  = request.security(syminfo.tickerid, "5",  close[htf_idx] > ta.ema(close, 21)[htf_idx], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
mtf_15m_up = request.security(syminfo.tickerid, "15", close[htf_idx] > ta.ema(close, 21)[htf_idx], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
mtf_d_up   = request.security(syminfo.tickerid, "D",  close[htf_idx] > ta.sma(close, 50)[htf_idx], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

mkt_bull     = not na(mkt_c) and not na(mkt_sma) and not na(mkt_vwap) and mkt_c > mkt_sma and mkt_c > mkt_vwap and mkt_roc >= 0.002
mkt_crash    = not na(mkt_c) and not na(mkt_sma) and not na(mkt_vwap) and mkt_c < mkt_sma and mkt_c < mkt_vwap and mkt_roc <= -0.003
vix_stressed = not na(vix_last) and vix_last >= i_vix_def
breadth_weak = not na(rsp_c) and not na(rsp_sma) and rsp_c < rsp_sma
spy_weak     = not na(spy_c) and not na(spy_sma) and spy_c < spy_sma

raw_regime = (mkt_crash or (vix_stressed and spy_weak)) ? -1 : mkt_bull ? 1 : 0
eff_regime = not i_use_mkt_reg ? 0 : is_inverse_etf ? -raw_regime : raw_regime

resolved_mode = i_omni_preset != "AUTO_REGIME_ADAPTIVE" ? i_omni_preset : (not is_rth and not is_ext ? "OVERNIGHT_24X5_IBKR" : raw_regime == -1 ? "CRASH_DEFENSIVE_INVERSE" : raw_regime == 1 ? "MINERVINI_VCP_BREAKOUT" : "LOSSLESS_TIGHT_SCALP")
rvol_min = resolved_mode == "STOCKBEE_EP_MOMENTUM_BURST" ? math.max(i_rvol_base, 2.5) : resolved_mode == "CRASH_DEFENSIVE_INVERSE" ? math.max(i_rvol_base, 1.8) : resolved_mode == "LOSSLESS_TIGHT_SCALP" ? math.max(1.2, i_rvol_base * 0.9) : i_rvol_base

// ── 8. Converged 8-Setup Multi-Situation, UV & Darkpool Library ─────────────
bar_range = high - low
clv       = bar_range > 0 ? (2.0 * close - high - low) / bar_range : 0.0
lower_wk  = math.min(open, close) - low
atr_5     = ta.atr(5)
vol_5     = ta.sma(vol_safe, 5)
coil_ok   = atr_val > 0 and (atr_5 / atr_val) <= 0.70
vdu_ok    = vol_sma > 0 and (vol_5 / vol_sma) <= 0.70
hi_20     = ta.highest(high, 20)[1]
hi_10     = ta.highest(high, 10)[1]
lo_10     = ta.lowest(low, 10)[1]
prev_lo5  = ta.lowest(low, 5)[1]
bar_chg   = close[1] > 0 ? (close - close[1]) / close[1] : 0.0

// Session Open / Gap Tracking for PEAD Drift & Official TradingView Intrabar Session CVD
string ltf_delta = timeframe.isseconds ? "1S" : timeframe.isintraday ? "1" : timeframe.isdaily ? "5" : "60"
[_, _, _, tv_sess_cvd] = tvta.requestVolumeDelta(ltf_delta, "1D")
var float sess_open_px   = na
var float prev_day_close = na
var float fallback_cvd   = 0.0
var float pre_open_px    = na
var float pre_hi_px      = na
if timeframe.change("D")
    prev_day_close := nz(close[1], open)
    sess_open_px   := open
    fallback_cvd   := 0.0
    pre_open_px    := is_pre ? open : na
    pre_hi_px      := is_pre ? high : na
if is_pre and not is_pre[1]
    pre_open_px := open
    pre_hi_px   := high
float prev_pre_hi = is_pre ? nz(pre_hi_px[1], hi_10) : hi_10
if is_pre
    pre_hi_px := na(pre_hi_px) ? high : math.max(pre_hi_px, high)
fallback_cvd += vol_safe * clv
sess_cvd     = nz(tv_sess_cvd, fallback_cvd)
cvd_ema      = ta.ema(sess_cvd, 9)
cvd_bull_div = barstate.isconfirmed and not na(prev_lo5) and low <= prev_lo5 and sess_cvd > nz(sess_cvd[5], sess_cvd) and clv > 0.20
gap_up_pct   = not na(sess_open_px) and not na(prev_day_close) and prev_day_close > 0 ? (sess_open_px - prev_day_close) / prev_day_close : 0.0
pre_move_pct = not na(prev_day_close) and prev_day_close > 0 ? (close - prev_day_close) / prev_day_close : (not na(pre_open_px) and pre_open_px > 0 ? (close - pre_open_px) / pre_open_px : bar_chg)

is_extreme        = atr_val > 0 and bar_range >= atr_val * i_ext_mult and rvol >= rvol_min
vol_buildup       = barstate.isconfirmed and ((rvol >= 1.8 and vol_safe > nz(volume[1], 0.0) and nz(volume[1], 0.0) >= vol_sma) or (vol_zscore >= i_uv_z_min and vol_buildup_ratio >= i_uv_vel_min))
premarket_ignition = barstate.isconfirmed and i_pre_ign_en and is_pre and close > open and close > ema_fast and (na(vwap_val) or close >= vwap_val) and (pre_move_pct >= 0.012 or bar_chg >= 0.008) and (rvol >= math.max(1.5, rvol_min) or vol_buildup or vol_buildup_ratio >= 1.6) and clv >= 0.40 and (na(prev_pre_hi) or close >= prev_pre_hi * 0.998)
hidden_vol_ratio  = math.max(0.0, math.round(nz(rvol / math.max(0.25, bar_range / math.max(nz(atr_val, syminfo.mintick), syminfo.mintick)), 0.0), 2))
vwap_pin_absorb   = barstate.isconfirmed and not na(vwap_val) and atr_val > 0 and math.abs(close - vwap_val) <= atr_val * 0.35 and rvol >= 2.0 and bar_range < atr_val * 0.85
hidden_vol_bull   = barstate.isconfirmed and rvol >= 2.0 and bar_range < atr_val * 0.85 and (clv >= 0.60 or (vwap_pin_absorb and clv >= 0.25 and sess_cvd >= cvd_ema))
hidden_vol_bear   = barstate.isconfirmed and rvol >= 2.0 and bar_range < atr_val * 0.85 and (clv <= -0.60 or (vwap_pin_absorb and clv <= -0.25 and sess_cvd < cvd_ema))
stage2_ok         = close > ema_slow and ema_slow >= ema_50 * 0.99
vcp_coil          = barstate.isconfirmed and not na(hi_20) and close >= hi_20 * 0.85 and coil_ok and vdu_ok
vcp_breakout      = barstate.isconfirmed and not na(hi_20) and stage2_ok and close > hi_20 and rvol >= rvol_min and clv >= 0.25 and (coil_ok[1] or vdu_ok[1])
ep_momentum_burst = barstate.isconfirmed and bar_chg >= 0.015 and bar_range >= atr_val * 1.6 and rvol >= 2.5 and clv >= 0.55 and close > ema_fast
pead_drift        = barstate.isconfirmed and gap_up_pct >= 0.020 and not na(vwap_val) and close > vwap_val and close > ema_fast and ema_fast > ema_slow and low <= ema_fast * 1.003 and close > open and rvol >= math.max(1.3, i_rvol_base * 0.9) and clv >= 0.35
exhaustion_hammer = barstate.isconfirmed and not na(prev_lo5) and low < prev_lo5 and close > prev_lo5 and bar_range > 0 and (lower_wk / bar_range) >= 0.55 and clv >= 0.45 and rvol >= 1.3
parabolic_top     = barstate.isconfirmed and not na(vwap_val) and ((close >= vwap_val * (1.0 + 2.0 * natr_out)) or (not na(vwap_u2) and high >= vwap_u2)) and rvol >= 2.5

long_extreme_rev  = is_extreme[1] and close[1] < open[1] and low[1] <= lo_10 and close > open and close > ema_fast
long_tight_scalp  = barstate.isconfirmed and not na(vwap_val) and close > vwap_val and close > ema_fast and ema_fast > ema_slow and low <= ema_fast and clv >= 0.50 and (rvol >= rvol_min or vol_buildup)
long_vcp_ep       = premarket_ignition or vcp_breakout or ep_momentum_burst or pead_drift or ((hidden_vol_bull or cvd_bull_div) and not na(vwap_val) and close > vwap_val and close > ema_fast)
on_liq_ok         = vol_safe > 0 and atr_val > 0 and (rvol >= math.max(1.3, rvol_min) or vol_buildup)

long_by_mode  = resolved_mode == "MINERVINI_VCP_BREAKOUT" ? (vcp_breakout or pead_drift or premarket_ignition) : resolved_mode == "STOCKBEE_EP_MOMENTUM_BURST" ? (premarket_ignition or ep_momentum_burst or pead_drift or hidden_vol_bull) : resolved_mode == "STOCKBEE_EXHAUSTION_HAMMER" ? (exhaustion_hammer or long_extreme_rev) : resolved_mode == "PARABOLIC_EXHAUSTION_SHORT" ? false : resolved_mode == "CRASH_DEFENSIVE_INVERSE" ? ((is_inverse_etf and (long_vcp_ep or long_extreme_rev)) or (ep_momentum_burst and rvol >= 4.0)) : resolved_mode == "LOSSLESS_TIGHT_SCALP" ? (long_tight_scalp or long_extreme_rev or long_vcp_ep) : resolved_mode == "OVERNIGHT_24X5_IBKR" ? (on_liq_ok and (long_extreme_rev or long_vcp_ep or exhaustion_hammer)) : (long_extreme_rev or long_vcp_ep or exhaustion_hammer)

short_crash_align = eff_regime == -1 and not na(vwap_val) and close < vwap_val and close < ema_fast and close < open and rvol >= rvol_min
short_peak_rev    = eff_regime != 1 and not na(vwap_val[1]) and (parabolic_top[1] or (is_extreme[1] and close[1] > open[1] and high[1] >= hi_10 and close[1] >= vwap_val[1] * (1.0 + natr_out))) and close < open and (close < low[1] or (not na(vwap_val) and close < vwap_val))
short_by_mode     = resolved_mode == "PARABOLIC_EXHAUSTION_SHORT" ? short_peak_rev : (resolved_mode == "MINERVINI_VCP_BREAKOUT" or resolved_mode == "STOCKBEE_EXHAUSTION_HAMMER") ? short_peak_rev : resolved_mode == "OVERNIGHT_24X5_IBKR" ? (on_liq_ok and (short_crash_align or short_peak_rev)) : (short_crash_align or short_peak_rev)

long_rev_raw  = barstate.isconfirmed and is_24x5_open and (eff_regime != -1 or (ep_momentum_burst and rvol >= 4.0)) and long_by_mode
short_rev_raw = barstate.isconfirmed and is_24x5_open and short_by_mode

// All 8 Converged Multi-Situation Setup Archetypes (+ PREMARKET_EARLY_IGNITION -> EARLY_EP_MOMENTUM_BURST schema parity)
setup_archetype    = (premarket_ignition or ep_momentum_burst) ? "EARLY_EP_MOMENTUM_BURST" : vcp_breakout ? "VCP_BREAKOUT" : pead_drift ? "PEAD_DRIFT" : exhaustion_hammer ? "EXHAUSTION_HAMMER" : (hidden_vol_bull or (vol_buildup and hidden_vol_ratio >= 2.0)) ? "HIDDEN_VOL_ACCUM" : parabolic_top ? "PARABOLIC_TOP" : short_crash_align ? "CRASH_ALIGNMENT" : short_peak_rev ? "PEAK_REVERSAL" : vcp_coil ? "VCP_COIL" : "EXTREME_REVERSAL"
potential_category = premarket_ignition ? "PREMARKET_EARLY_IGNITION" : ep_momentum_burst ? "EP_MOMENTUM_BURST" : vcp_breakout ? "VCP_STAGE2_BREAKOUT" : pead_drift ? "PEAD_DRIFT" : exhaustion_hammer ? "EXHAUSTION_HAMMER" : (hidden_vol_bull or (vol_buildup and hidden_vol_ratio >= 2.0)) ? "DARKPOOL_ACCUMULATION" : (parabolic_top or short_peak_rev) ? "PARABOLIC_PEAK_REVERSAL" : short_crash_align ? "CRASH_INVERSE_HEDGE" : vol_buildup ? "SUDDEN_VOLUME_SURGE" : "EXTREME_MOVER_WATCH"

// ── 8b. Per-Symbol, Per-Situation Non-Noise Min-Trail Floor (Exact engine.py Parity) ─
resolve_situation_trail_mult(string cat, string arch) =>
    if cat == "PARABOLIC_PEAK_REVERSAL" or arch == "PARABOLIC_TOP" or arch == "PEAK_REVERSAL"
        0.20
    else if cat == "CRASH_INVERSE_HEDGE" or arch == "CRASH_ALIGNMENT" or arch == "EXTREME_REVERSAL"
        0.22
    else if arch == "EXHAUSTION_HAMMER" or arch == "VCP_COIL"
        0.25
    else if cat == "PREMARKET_EARLY_IGNITION"
        0.28
    else if cat == "DARKPOOL_ACCUMULATION" or arch == "HIDDEN_VOL_ACCUM"
        0.32
    else if cat == "VCP_STAGE2_BREAKOUT" or arch == "VCP_BREAKOUT" or arch == "PEAD_DRIFT"
        0.35
    else
        0.30

float two_tick_pct             = close > 0 ? (2.0 * rule612_tick(close)) / close : 0.0002
float fee_spread_noise_floor   = (i_fee_bps_side * 2.0 + 2.0 + i_est_spread_bps * 1.5 + sess_noise_bps) / 10000.0
float sit_trail_mult           = resolve_situation_trail_mult(potential_category, setup_archetype)
float min_non_noise_trail_pct  = math.min(sess_init_cap, math.max(fee_spread_noise_floor, math.max(sit_trail_mult * natr_out, two_tick_pct)))
float fast_sell_rev_pct        = min_non_noise_trail_pct

resolve_farm_lane(string arch, string sess, string broker) =>
    if sess == "OVERNIGHT" and (broker == "IBKR" or arch == "CRASH_ALIGNMENT" or arch == "PEAK_REVERSAL" or arch == "PARABOLIC_TOP")
        "IBKR_4002 (24/5 ON)"
    else if arch == "CRASH_ALIGNMENT" or arch == "PEAK_REVERSAL" or arch == "PARABOLIC_TOP"
        "PA3 (Crash/Rev)"
    else if arch == "VCP_BREAKOUT" or arch == "VCP_COIL" or arch == "PEAD_DRIFT" or arch == "HIDDEN_VOL_ACCUM"
        "PA2 (VCP/PEAD/Acc)"
    else
        "PA1 (Momentum)"

target_farm_lane = resolve_farm_lane(setup_archetype, sess_label, vh.broker)

// ── 9. Stateful Monotonic Lossless Trailing, Auto-Reverse & Re-Entry FSM ────
var int   pos_dir         = 0
var float entry_px        = na
var float init_stop_px    = na
var float stop_px         = na
var float best_px         = na
var bool  be_armed        = false
var int   lock_tier       = 0
var int   pending_rev_dir = 0
var int   last_exit_ts    = na
var int   last_exit_dir   = 0
var bool  did_reverse     = false

bool entered_long  = false
bool entered_short = false
bool exited_stop   = false
bool exited_rev    = false

standard_minute  = chart.is_standard and timeframe.isminutes and timeframe.multiplier == 1
bench_age_ms     = not na(mkt_close_ts) ? time_close - mkt_close_ts : 999999999
bench_max_age_ms = is_rth ? 120000 : 900000
benchmark_ready  = not na(mkt_close_ts) and bench_age_ms >= 0 and bench_age_ms <= bench_max_age_ms and not na(mkt_c) and not na(mkt_sma) and not na(mkt_vwap) and not na(mkt_roc)
practice_ready   = not i_use_mkt_reg or benchmark_ready
signal_dir       = not practice_ready or long_rev_raw == short_rev_raw ? 0 : long_rev_raw ? 1 : -1
fast_sell_climax    = barstate.isconfirmed and is_24x5_open and i_fast_sell_rev and eff_regime != 1 and (parabolic_top or (close < open and close < ema_fast and close < low[1] and not na(vwap_val) and (close < vwap_val or high[1] >= vwap_val[1] * (1.0 + natr_out)) and rvol >= math.max(1.2, rvol_min * 0.7)))
float cur_bar_best  = pos_dir == 1 ? math.max(nz(best_px, high), high) : pos_dir == -1 ? math.min(nz(best_px, low), low) : na
float cur_leg_risk  = pos_dir != 0 and not na(entry_px) and not na(init_stop_px) ? math.max(syminfo.mintick, math.abs(entry_px - init_stop_px)) : na
float cur_r_mult    = pos_dir != 0 and not na(cur_leg_risk) and not na(cur_bar_best) ? pos_dir * (cur_bar_best - entry_px) / cur_leg_risk : 0.0
float cur_peak_pb   = pos_dir == 1 and not na(cur_bar_best) and cur_bar_best > 0 ? math.max(0.0, (cur_bar_best - close) / cur_bar_best) : pos_dir == -1 and not na(cur_bar_best) and cur_bar_best > 0 ? math.max(0.0, (close - cur_bar_best) / cur_bar_best) : 0.0
peak_hit_exhaustion = barstate.isconfirmed and is_24x5_open and i_fast_sell_rev and pos_dir == 1 and not na(cur_leg_risk) and ((cur_r_mult >= 2.5 and cur_peak_pb >= min_non_noise_trail_pct and close < open) or (parabolic_top and cur_r_mult >= 1.5 and clv <= -0.25 and cur_peak_pb >= min_non_noise_trail_pct))
fast_sell_nn_trend  = barstate.isconfirmed and is_24x5_open and pos_dir != 0 and be_armed and cur_peak_pb >= fast_sell_rev_pct and ((pos_dir == 1 and close < open and close < ema_fast) or (pos_dir == -1 and close > open and close > ema_fast))
peak_confirmed      = barstate.isconfirmed and (short_peak_rev or fast_sell_climax or peak_hit_exhaustion)

if barstate.isconfirmed and is_24x5_open and pos_dir != 0
    bool stop_touched   = pos_dir == 1 ? low <= stop_px : high >= stop_px
    bool climax_flip    = pos_dir == 1 and (fast_sell_climax or peak_hit_exhaustion)
    bool opp_sig        = i_auto_reverse and (signal_dir == -pos_dir or climax_flip)
    bool retire         = stop_touched or opp_sig
    if not retire
        best_px := pos_dir == 1 ? math.max(best_px, high) : math.min(best_px, low)
        float hard = hard_stop(entry_px, pos_dir, sess_init_cap)
        if na(hard)
            retire := true
        else
            float next_stop = pos_dir == 1 ? math.max(stop_px, hard) : math.min(stop_px, hard)
            float fav_move  = pos_dir * (best_px - entry_px) / entry_px
            float leg_risk  = not na(init_stop_px) ? math.max(syminfo.mintick, math.abs(entry_px - init_stop_px)) : na
            float r_mult    = not na(leg_risk) ? pos_dir * (best_px - entry_px) / leg_risk : 0.0
            if fav_move >= be_trig and not na(trail_pct)
                be_armed  := true
                lock_tier := math.max(lock_tier, 1)
                float raw_be  = math.max(0.0001, entry_px * (1.0 + pos_dir * fee_buf))
                float be_stop = inward_stop(raw_be, pos_dir)
                if pos_dir * (best_px - raw_be) > 0 and pos_dir * (best_px - be_stop) > 0
                    next_stop := pos_dir == 1 ? math.max(next_stop, be_stop) : math.min(next_stop, be_stop)
                float eff_trail_pct = trail_pct
                if i_prog_lock and not na(leg_risk)
                    if r_mult >= 3.0 or (parabolic_top and pos_dir == 1 and r_mult >= 1.5)
                        lock_tier     := math.max(lock_tier, 4)
                        eff_trail_pct := math.min(trail_pct, math.max(0.0010, trail_pct * 0.25))
                        float lock3 = inward_stop(math.max(0.0001, entry_px + pos_dir * 2.35 * leg_risk), pos_dir)
                        if pos_dir * (best_px - lock3) > 0
                            next_stop := pos_dir == 1 ? math.max(next_stop, lock3) : math.min(next_stop, lock3)
                    else if r_mult >= 2.0
                        lock_tier     := math.max(lock_tier, 3)
                        eff_trail_pct := math.min(trail_pct, math.max(0.0012, trail_pct * 0.40))
                        float lock2 = inward_stop(math.max(0.0001, entry_px + pos_dir * 1.35 * leg_risk), pos_dir)
                        if pos_dir * (best_px - lock2) > 0
                            next_stop := pos_dir == 1 ? math.max(next_stop, lock2) : math.min(next_stop, lock2)
                    else if r_mult >= 1.0
                        lock_tier     := math.max(lock_tier, 2)
                        eff_trail_pct := math.min(trail_pct, math.max(0.0015, trail_pct * 0.65))
                        float lock1 = inward_stop(math.max(0.0001, entry_px + pos_dir * 0.45 * leg_risk), pos_dir)
                        if pos_dir * (best_px - lock1) > 0
                            next_stop := pos_dir == 1 ? math.max(next_stop, lock1) : math.min(next_stop, lock1)
                if i_use_nn_trail
                    eff_trail_pct := fast_sell_nn_trend ? min_non_noise_trail_pct : math.min(sess_init_cap, math.max(eff_trail_pct, min_non_noise_trail_pct))
                float trail_stop = inward_stop(best_px * (1.0 - pos_dir * eff_trail_pct), pos_dir)
                if pos_dir * (best_px - trail_stop) <= 0
                    float tick = pos_dir == 1 and best_px <= 1.0 ? 0.0001 : rule612_tick(best_px)
                    trail_stop := inward_stop(math.max(0.0001, best_px - pos_dir * tick), pos_dir)
                if pos_dir * (best_px - trail_stop) > 0
                    next_stop := pos_dir == 1 ? math.max(next_stop, trail_stop) : math.min(next_stop, trail_stop)
            retire := pos_dir * (close - next_stop) <= 0
            if not retire
                stop_px := next_stop
    if retire
        int rev_target  = (opp_sig and not stop_touched) ? (climax_flip ? -1 : signal_dir) : ((fast_sell_climax or peak_hit_exhaustion) and pos_dir == 1 and i_auto_reverse ? -1 : 0)
        pending_rev_dir := rev_target
        exited_stop     := stop_touched
        exited_rev      := opp_sig and not stop_touched
        last_exit_dir   := pos_dir
        last_exit_ts    := time_close
        pos_dir         := 0
        entry_px        := na
        init_stop_px    := na
        stop_px         := na
        best_px         := na
        be_armed        := false
        lock_tier       := 0
        leg_schedule    := ""

later_bar   = na(last_exit_ts) or time_close > last_exit_ts
cooldown_ok = na(last_exit_ts) or time_close - last_exit_ts >= i_cooldown_sec * 1000
eff_signal  = pending_rev_dir != 0 ? pending_rev_dir : signal_dir
reentry_ok  = eff_signal != last_exit_dir or (i_auto_reentry and cooldown_ok) or pending_rev_dir != 0
if barstate.isconfirmed and is_24x5_open and pos_dir == 0 and eff_signal != 0 and later_bar and reentry_ok and not na(natr_out)
    pending_rev_dir := 0
    float trigger = math.round(close, 4)
    float initial = hard_stop(trigger, eff_signal, sess_init_cap)
    if not na(initial)
        did_reverse   := last_exit_dir != 0 and eff_signal == -last_exit_dir
        pos_dir       := eff_signal
        entry_px      := trigger
        init_stop_px  := initial
        best_px       := trigger
        stop_px       := initial
        be_armed      := false
        lock_tier     := 0
        leg_schedule  := sched_id
        entered_long  := pos_dir == 1
        entered_short := pos_dir == -1
else if barstate.isconfirmed and later_bar and pending_rev_dir != 0
    pending_rev_dir := 0

// Compute Lossless BE & R-Multiple Rungs for active display leg
risk_r   = pos_dir != 0 and not na(entry_px) and not na(init_stop_px) ? math.abs(entry_px - init_stop_px) : na
be_floor = pos_dir != 0 and not na(entry_px) ? inward_stop(math.max(0.0001, entry_px * (1.0 + pos_dir * fee_buf)), pos_dir) : na
rung_1r  = pos_dir != 0 and not na(risk_r) ? entry_px + pos_dir * risk_r : na
rung_2r  = pos_dir != 0 and not na(risk_r) ? entry_px + pos_dir * 2.0 * risk_r : na
rung_3r  = pos_dir != 0 and not na(risk_r) ? entry_px + pos_dir * 3.0 * risk_r : na

// Build Copy-Ready OrderPresetCard UDT (Live Leg OR Standby Reference at Close)
alpaca_on_short_blocked = vh.broker == "ALPACA" and sess_label == "OVERNIGHT"
rev_short_mode = i_etb_short and not alpaca_on_short_blocked ? "DIRECT_SHORT_ETB" : i_etb_short ? "ROUTE_IBKR_OR_INVERSE_HEDGE_SOXS_SQQQ" : "INVERSE_HEDGE_SOXS_SQQQ"

build_order_card() =>
    bool live_leg = pos_dir != 0 and not na(entry_px) and not na(init_stop_px)
    int dir = live_leg ? pos_dir : (eff_regime == -1 ? -1 : 1)
    float ref_e = live_leg ? entry_px : math.round(close, 4)
    float ref_s = live_leg ? stop_px : nz(hard_stop(ref_e, dir, auto_init_cap), inward_stop(ref_e * (1.0 - dir * auto_init_cap), dir))
    float ref_init = live_leg ? init_stop_px : ref_s
    float r_unit = math.max(rule612_tick(ref_e), math.abs(ref_e - ref_init))
    float e_lim = is_rth ? ref_e : collared_entry_limit(ref_e, dir, collar_bps)
    float s_lim = is_rth ? ref_s : collared_stop_limit(ref_s, dir, collar_bps)
    float s_pct = ref_e > 0 ? math.abs(ref_e - ref_s) / ref_e * 100.0 : 0.0
    float be_p = inward_stop(ref_e * (1.0 + dir * fee_buf), dir)
    float t1 = outward_limit(ref_e + dir * 1.0 * r_unit, dir)
    float l1 = inward_stop(ref_e + dir * 0.45 * r_unit, dir)
    float t2 = outward_limit(ref_e + dir * 2.0 * r_unit, dir)
    float l2 = inward_stop(ref_e + dir * 1.35 * r_unit, dir)
    float t3 = outward_limit(ref_e + dir * 3.0 * r_unit, dir)
    float l3 = inward_stop(ref_e + dir * 2.35 * r_unit, dir)
    float rev_base = live_leg and not na(best_px) ? best_px : ref_e
    float f_rev = inward_stop(rev_base * (1.0 - dir * fast_sell_rev_pct), dir)
    float r_budget = raw_regime == -1 ? 0.0025 : 0.0050
    int s25 = size_by_risk(25000.0, ref_e, ref_init, r_budget, 0.15)
    int s100 = size_by_risk(100000.0, ref_e, ref_init, r_budget, 0.15)
    OrderPresetCard.new(
        live_leg,
        dir == 1 ? "BUY" : "SELL",
        dir == -1 ? rev_short_mode : (is_inverse_etf ? "INVERSE_HEDGE_LONG" : "DIRECT_LONG"),
        order_type,
        is_rth ? "DAY" : "GTC · ExtHrs ON",
        collar_bps,
        ref_e,
        e_lim,
        ref_s,
        s_lim,
        s_pct,
        be_p,
        t1,
        l1,
        t2,
        l2,
        t3,
        l3,
        f_rev,
        s25,
        s100
    )

// ── 10. Visual Overlays, VWAP Bands, Lossless Stop & Profit-Lock Rungs ──────
plot(ema_fast, "EMA 9",  color=color.new(color.teal, 20), linewidth=1)
plot(ema_slow, "EMA 21", color=color.new(color.orange, 30), linewidth=1)
plot(ema_50,   "EMA 50", color=color.new(color.purple, 55), linewidth=1)
plot(vwap_val, "Session VWAP", color=color.new(color.blue, 25), linewidth=2)
plot(i_show_vwap_bnd ? vwap_u1 : na, "VWAP +1s", color=color.new(color.blue, 72), linewidth=1)
plot(i_show_vwap_bnd ? vwap_d1 : na, "VWAP -1s", color=color.new(color.blue, 72), linewidth=1)
plot(i_show_vwap_bnd ? vwap_u2 : na, "VWAP +2s Exhaustion", color=color.new(color.fuchsia, 68), linewidth=1)
plot(i_show_vwap_bnd ? vwap_d2 : na, "VWAP -2s Exhaustion", color=color.new(color.teal, 68), linewidth=1)

stop_col = be_armed ? color.new(color.lime, 0) : color.new(color.red, 0)
plot(pos_dir != 0 ? stop_px : na, "Lossless Monotonic Stop", color=stop_col, style=plot.style_linebr, linewidth=2)
plot(i_show_rungs and pos_dir != 0 ? be_floor : na, "BE+Fee Floor", color=color.new(color.yellow, 35), style=plot.style_linebr, linewidth=1)
plot(i_show_rungs and pos_dir != 0 ? rung_1r  : na, "+1R Target",   color=color.new(color.aqua, 55), style=plot.style_linebr, linewidth=1)
plot(i_show_rungs and pos_dir != 0 ? rung_2r  : na, "+2R Target",   color=color.new(color.lime, 55), style=plot.style_linebr, linewidth=1)
plot(i_show_rungs and pos_dir != 0 ? rung_3r  : na, "+3R Target",   color=color.new(color.rgb(16, 185, 129), 45), style=plot.style_linebr, linewidth=1)

plotshape(entered_long,  title="Long Entry / Re-Entry",  style=shape.triangleup,   location=location.belowbar, color=color.lime,    size=size.small)
plotshape(entered_short, title="Short Entry / Crash",    style=shape.triangledown, location=location.abovebar, color=color.fuchsia, size=size.small)
plotshape(exited_rev,    title="Auto-Reverse Flatten",   style=shape.flag,         location=location.abovebar, color=color.orange,  size=size.tiny)
plotshape(ep_momentum_burst, title="EP / 4% Momentum Burst", style=shape.diamond,  location=location.belowbar, color=color.yellow,  size=size.small)
plotshape(vcp_breakout and not entered_long, title="VCP Breakout", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.tiny)
plotshape(pead_drift and not entered_long, title="PEAD Gap Drift", style=shape.square, location=location.belowbar, color=color.new(color.lime, 20), size=size.tiny)
plotshape(exhaustion_hammer, title="Exhaustion Hammer",  style=shape.labelup,      location=location.belowbar, color=color.new(color.teal, 20), text="H", textcolor=color.white, size=size.tiny)
plotshape(hidden_vol_bull, title="Hidden Vol Accum",     style=shape.circle,       location=location.belowbar, color=color.new(color.green, 15), size=size.tiny)
plotshape(hidden_vol_bear, title="Hidden Vol Distrib",   style=shape.circle,       location=location.abovebar, color=color.new(color.maroon, 15), size=size.tiny)
plotshape(parabolic_top,      title="Parabolic Top",             style=shape.xcross,       location=location.abovebar, color=color.yellow, size=size.tiny)
plotshape(premarket_ignition, title="Premarket Early Ignition",  style=shape.labelup,      location=location.belowbar, color=color.new(color.aqua, 10), text="PRE", textcolor=color.black, size=size.tiny)
plotshape(peak_hit_exhaustion, title="Peak-Hit Climax Reverse",  style=shape.labeldown,    location=location.abovebar, color=color.new(color.fuchsia, 10), text="PK", textcolor=color.white, size=size.tiny)

bgcolor(i_show_bg ? (eff_regime == -1 ? color.new(color.red, 92) : vcp_coil ? color.new(color.aqua, 94) : na) : na, title="Regime / VCP Tint")

// ── 11. Institutional SOTA Status HUD (Top-Right) & Order Preset HUD (Bottom-Right) ─
var table hud = table.new(position.top_right, 2, 15, border_width=1, border_color=color.new(color.gray, 55))
var table ord_hud = table.new(position.bottom_right, 2, 13, border_width=1, border_color=color.new(color.gray, 55))

if barstate.islast and i_show_diag
    pair_mode  = is_inverse_etf ? "INVERSE_HEDGE" : is_soxl ? "SOXL_BULL_3X" : is_semi_sym ? "SEMI_LEADER" : "EQUITY_BROAD"
    pair_badge = pair_sym != "" ? " <-> " + pair_sym : ""
    reg_txt    = raw_regime == 1 ? "RISK-ON (+1)" : raw_regime == -1 ? "CRASH DEF (-1)" : "NEUTRAL (0)"
    vix_txt    = na(vix_last) ? "N/A" : str.tostring(vix_last, "0.00")
    br_txt     = breadth_weak ? "WEAK" : "OK"
    bfresh_txt = benchmark_ready ? "FRESH" : "STALE"
    mtf_txt    = (close > ema_slow ? "1m▲ " : "1m▼ ") + (mtf_5m_up ? "5m▲ " : "5m▼ ") + (mtf_15m_up ? "15m▲ " : "15m▼ ") + (mtf_d_up ? "D▲" : "D▼")
    tier_tag   = lock_tier >= 4 ? " [T4 FAST-SELL]" : lock_tier == 3 ? " [T3 +2R LOCK]" : lock_tier == 2 ? " [T2 +1R LOCK]" : be_armed ? " [T1 BE+]" : " [HARD CAP]"
    stop_txt   = na(stop_px) ? "Flat (Cap " + str.tostring(sess_init_cap * 100.0, "0.00") + "%)" : str.tostring(stop_px, "0.####") + tier_tag
    sched_note = i_sched_ovr != "AUTO_NATR" ? " [OVR; Bridge=" + auto_sched + "]" : ""
    dvol_m     = dollar_vol / 1000000.0
    vol_txt    = (vol_buildup ? "UV RAMP · " : hidden_vol_bull ? "ABSORB+ · " : hidden_vol_bear ? "DISTRIB · " : "NORMAL · ") + "Z=" + str.tostring(vol_zscore, "0.#") + " · VBR " + str.tostring(vol_buildup_ratio, "0.#") + "x · HVR " + str.tostring(hidden_vol_ratio, "0.##")
    vol_bg     = vol_buildup ? color.new(color.teal, 55) : hidden_vol_bull ? color.new(color.green, 65) : hidden_vol_bear ? color.new(color.maroon, 60) : color.new(color.gray, 85)

    table.cell(hud, 0, 0,  "Omni Preset",   bgcolor=color.new(color.navy, 35), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0,  resolved_mode,   bgcolor=color.new(color.navy, 55), text_color=color.aqua,  text_size=size.small)
    table.cell(hud, 0, 1,  "Market Status", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1,  reg_txt + " | VIX " + vix_txt, bgcolor=raw_regime == -1 ? color.new(color.red, 55) : raw_regime == 1 ? color.new(color.green, 65) : color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 2,  "Breadth/Bench", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2,  br_txt + " [" + bench_sym + " · " + bfresh_txt + "]", bgcolor=not benchmark_ready ? color.new(color.maroon, 55) : breadth_weak ? color.new(color.orange, 65) : color.new(color.green, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 3,  "24/5 Session",  bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3,  sess_order_badge, bgcolor=is_rth ? color.new(color.gray, 85) : color.new(color.navy, 55), text_color=is_rth ? color.white : color.aqua, text_size=size.small)
    table.cell(hud, 0, 4,  "Lossless Sched",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4,  active_schedule + " (NATR " + str.tostring(natr_out * 100.0, "0.00") + "%)" + sched_note, bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 5,  "Trail / NN-Min",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5,  "BE " + str.tostring(be_trig * 100.0, "0.00") + "% · Trail " + str.tostring(trail_pct * 100.0, "0.00") + "% · NN-Min " + str.tostring(min_non_noise_trail_pct * 100.0, "0.00") + "%", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 6,  "Active Stop",   bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 6,  stop_txt,        bgcolor=be_armed ? color.new(color.green, 65) : color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 7,  "Pair / Short",  bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 7,  pair_mode + pair_badge + " | " + rev_short_mode, bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 8,  "Setup / Lane",  bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 8,  setup_archetype + " -> " + target_farm_lane + " (" + str.tostring(rvol, "0.00") + "x · $" + str.tostring(dvol_m, "0.00") + "M)", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 9,  "Vol / Absorb",  bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 9,  vol_txt,         bgcolor=vol_bg, text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 10, "Darkpool Proxy",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    dp_txt = (vwap_pin_absorb ? "VWAP-PIN ABSORB" : cvd_bull_div ? "CVD BULL DIV" : sess_cvd >= cvd_ema ? "CVD ACCUM (+)" : "CVD DISTRIB (-)") + " · Peak=" + str.tostring(peak_confirmed)
    table.cell(hud, 1, 10, dp_txt,          bgcolor=vwap_pin_absorb ? color.new(color.teal, 50) : color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    if i_show_mtf
        table.cell(hud, 0, 11, "MTF / TV Rating", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
        table.cell(hud, 1, 11, mtf_txt + " · TV " + tv_rating_lbl + " (" + str.tostring(tv_rating_all, "0.00") + ")", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 12, "Auto-Rev/Gate", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    gate_txt = "Rev=" + str.tostring(i_auto_reverse) + (did_reverse ? " [FLIP]" : "") + " Re=" + str.tostring(i_auto_reentry) + " · qty=1 (display-only)"
    table.cell(hud, 1, 12, gate_txt,        bgcolor=color.new(color.orange, 70), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 13, "Early Ign / Cat", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    ign_txt = (premarket_ignition ? "PRE-IGNITION [LIVE] · " : is_pre ? "PRE-WATCH · " : "") + potential_category
    table.cell(hud, 1, 13, ign_txt,         bgcolor=premarket_ignition ? color.new(color.teal, 45) : color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 14, "1000rpm Rapid", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    rapid_txt = str.tostring(vh.max_rpm, "0") + "rpm (" + str.tostring(vh.cadence_secs, "0.##") + "s) · Re=" + str.tostring(i_cooldown_sec, "0") + "s · PeakRev=" + (peak_confirmed ? "ARMED" : "READY")
    table.cell(hud, 1, 14, rapid_txt,       bgcolor=peak_confirmed ? color.new(color.fuchsia, 55) : color.new(color.navy, 55), text_color=color.aqua, text_size=size.small)

if barstate.islast and i_show_ord_hud
    OrderPresetCard card = build_order_card()
    string hdr_tag = card.is_live_leg ? "LIVE LEG" : "STANDBY REF"
    string col_hdr = card.side == "BUY" ? "BUY LONG" : "SELL SHORT"
    color side_bg  = card.side == "BUY" ? color.new(color.green, 55) : color.new(color.maroon, 50)
    string ent_str = is_rth ? str.tostring(card.entry_px, "0.####") + " (MKT)" : str.tostring(card.entry_px, "0.####") + " -> Lmt " + str.tostring(card.entry_limit, "0.####")
    string stp_str = is_rth ? str.tostring(card.stop_px, "0.####") + " (" + str.tostring(card.stop_pct, "0.00") + "%)" : str.tostring(card.stop_px, "0.####") + " / Lmt " + str.tostring(card.stop_limit, "0.####") + " (" + str.tostring(card.stop_pct, "0.00") + "%)"
    string rpm_str = str.tostring(vh.max_rpm, "0") + "rpm/" + str.tostring(vh.max_rps, "0") + "rps · Ent " + str.tostring(vh.entry_modify_rpm, "0") + " · ExitRes " + str.tostring(vh.exit_reserve_rpm, "0") + " (10%)"
    string lane_str = "Max " + str.tostring(vh.max_trailed_pos, "0") + " pos (" + str.tostring(vh.cadence_secs, "0.##") + "s) · " + target_farm_lane
    string s5_tag   = vh.is_stage5_parity ? " [STAGE-5]" : ""

    table.cell(ord_hud, 0, 0,  "TV Order Preset [" + hdr_tag + "]", bgcolor=color.new(color.navy, 30), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 0,  col_hdr + " · " + vh.profile_id + " · qty=1", bgcolor=side_bg, text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 0, 1,  "Order Handle RPM", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 1,  rpm_str,            bgcolor=color.new(color.navy, 55), text_color=color.aqua,  text_size=size.small)
    table.cell(ord_hud, 0, 2,  "Trail Cap / Lane", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 2,  lane_str,           bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 0, 3,  "Route / Setup",    bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 3,  card.route_mode + (pair_sym != "" ? " [" + pair_sym + "]" : "") + " · " + setup_archetype, bgcolor=color.new(color.gray, 85), text_color=color.aqua, text_size=size.small)
    table.cell(ord_hud, 0, 4,  "Order / 24x5",     bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 4,  card.order_type + " (" + str.tostring(card.collar_bps, "0") + "bp) · " + (is_rth ? "NATIVE_RATCHET" : is_ext ? "SYNTHETIC_COLLARED_LIMIT" : "BOATS_COLLARED_LIMIT"), bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 0, 5,  "Entry / Collar",   bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 5,  ent_str,            bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 0, 6,  "Initial SL (R612)",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 6,  stp_str,            bgcolor=color.new(color.red, 70),  text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 0, 7,  "T1 BE+10bp Floor", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 7,  str.tostring(card.be_floor, "0.####") + " (Arm +" + str.tostring(be_trig * 100.0, "0.00") + "%)", bgcolor=color.new(color.olive, 65), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 0, 8,  "T2 +1R -> +0.45R", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 8,  "Tgt " + str.tostring(card.t1r, "0.####") + " -> Lock " + str.tostring(card.l1r, "0.####"), bgcolor=color.new(color.gray, 85), text_color=color.aqua, text_size=size.small)
    table.cell(ord_hud, 0, 9,  "T3 +2R -> +1.35R", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 9,  "Tgt " + str.tostring(card.t2r, "0.####") + " -> Lock " + str.tostring(card.l2r, "0.####"), bgcolor=color.new(color.gray, 85), text_color=color.lime, text_size=size.small)
    table.cell(ord_hud, 0, 10, "T4 +3R / Fast-Rev",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 10, "Tgt " + str.tostring(card.t3r, "0.####") + " -> Lock " + str.tostring(card.l3r, "0.####") + " | Rev " + str.tostring(card.fast_rev, "0.####"), bgcolor=color.new(color.green, 70), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 0, 11, "Size ($25k/$100k)",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 11, str.tostring(card.sh_25k, "0") + " / " + str.tostring(card.sh_100k, "0") + " sh · semi_auto=false" + s5_tag, bgcolor=color.new(color.orange, 70), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 0, 12, "NN-Min / Adopt",   bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(ord_hud, 1, 12, "NN-Min " + str.tostring(min_non_noise_trail_pct * 100.0, "0.00") + "% (x" + str.tostring(sit_trail_mult, "0.##") + ") · 24/5 Auto-Adopt", bgcolor=color.new(color.teal, 55), text_color=color.white, text_size=size.small)

// ── 12. Strict Schema-Compatible tier0.tv-alert.v1 Payload Emitter ──────────
emit_alert_json(string sig_side, float trig_px, float stp_px) =>
    int side_int = sig_side == "BUY" ? 1 : -1
    float safe_trig = math.max(0.0001, nz(trig_px, close))
    float bridge_stp = nz(hard_stop(safe_trig, side_int, auto_init_cap), nz(stp_px, safe_trig))
    float stp_dist = math.min(0.02, math.max(0.0, math.round(math.abs(safe_trig - bridge_stp) / safe_trig, 6)))
    bool force_ibkr_on = vh.broker == "ALPACA" and sig_side == "SELL" and sess_label == "OVERNIGHT"
    string eff_venue = force_ibkr_on ? "IBKR" : vh.broker
    string eff_venue_profile = force_ibkr_on ? "IBKR_PAPER_4002" : i_venue_profile
    string pair_json = pair_sym != "" ? ",\"pair_symbol\":\"" + pair_sym + "\"" : ""
    (
        "{\"schema_version\":\"tier0.tv-alert.v1\"" +
        ",\"symbol\":\"" + tkr + "\"" +
        ",\"ts_utc_ms\":" + str.tostring(time_close, "0") +
        ",\"bar_confirmed\":true" +
        ",\"side\":\"" + sig_side + "\"" +
        ",\"qty\":1" +
        ",\"venue\":\"" + eff_venue + "\"" +
        ",\"venue_profile\":\"" + eff_venue_profile + "\"" +
        ",\"session\":\"" + sess_label + "\"" +
        ",\"order_type\":\"" + order_type + "\"" +
        ",\"trigger_price\":" + str.tostring(safe_trig, "0.####") +
        ",\"stop_price\":" + str.tostring(bridge_stp, "0.####") +
        ",\"stop_distance_pct\":" + str.tostring(stp_dist, "0.######") +
        ",\"limit_collar_bps\":" + str.tostring(collar_bps, "0") +
        ",\"trailing_schedule\":\"" + auto_sched + "\"" +
        ",\"natr_pct\":" + str.tostring(natr_out, "0.######") +
        ",\"auto_reverse\":" + str.tostring(i_auto_reverse) +
        ",\"auto_reentry\":" + str.tostring(i_auto_reentry) +
        ",\"reentry_cooldown_secs\":" + str.tostring(i_cooldown_sec, "0") +
        ",\"strategy_id\":\"SignalExecutionStrategy\"" +
        ",\"semi_auto_confirmed\":false" +
        ",\"setup_archetype\":\"" + setup_archetype + "\"" +
        ",\"macro_regime\":" + str.tostring(eff_regime, "0") +
        ",\"rvol\":" + str.tostring(math.max(0.0, nz(rvol, 1.0)), "0.##") +
        ",\"hidden_volume_ratio\":" + str.tostring(math.max(0.0, nz(hidden_vol_ratio, 0.0)), "0.##") +
        ",\"vol_buildup_ratio\":" + str.tostring(math.max(0.0, nz(vol_buildup_ratio, 1.0)), "0.##") +
        ",\"unusual_volume_buildup\":" + str.tostring(vol_buildup) +
        ",\"peak_confirmed\":" + str.tostring(peak_confirmed) +
        ",\"is_leveraged_or_inverse\":" + str.tostring(is_lev_or_inv) +
        pair_json +
        ",\"script_kind\":\"indicator\"" +
        ",\"order_preset_id\":\"" + resolved_mode + "\"" +
        ",\"data_source\":\"tradingview_pine_v6\"}"
    )

if entered_long and standard_minute
    alert(emit_alert_json("BUY", entry_px, stop_px), alert.freq_once_per_bar_close)
if entered_short and standard_minute
    alert(emit_alert_json("SELL", entry_px, stop_px), alert.freq_once_per_bar_close)

// ── 13. Non-Repainting Alert Conditions (Watchlist & Chart Visual Alerts) ───
alertcondition(entered_long,      title="Tier-0 Long Entry / Re-Entry",      message="T0_OMNI_SOTA LONG confirmed on {{ticker}} @ {{close}}")
alertcondition(entered_short,     title="Tier-0 Short Entry / Crash",        message="T0_OMNI_SOTA SHORT confirmed on {{ticker}} @ {{close}}")
