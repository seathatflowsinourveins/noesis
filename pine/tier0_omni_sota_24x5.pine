//@version=6
indicator("Tier-0 Omni SOTA 24x5 Lossless, Auto-Reverse & Regime", shorttitle="T0_OMNI_SOTA", overlay=true, max_bars_back=500, max_lines_count=200, max_labels_count=200)

// ============================================================================
// Tier-0 SOTA — Omni 24/5 Display, Lossless Trailing & Regime Indicator
// Parity: src/tier0_sota/engine.py & src/tier0_sota/risk.py (Rule-612 <= 2.00% cap)
// Compliance: Display-only Pine v6 + tier0.tv-alert.v1 JSON (semi_auto_confirmed=false, qty=1)
// Non-Repainting: barstate.isconfirmed + gaps=barmerge.gaps_off + lookahead=barmerge.lookahead_off
// ============================================================================

// ── 1. Omni Use-Case Preset Selector ────────────────────────────────────────
grp_omni = "01 · Omni Use-Case & Market Tuning"
i_omni_preset = input.string(
    "AUTO_REGIME_ADAPTIVE",
    "Omni SOTA Preset Mode",
    options=[
        "AUTO_REGIME_ADAPTIVE",
        "LOSSLESS_TIGHT_SCALP",
        "CRASH_DEFENSIVE_INVERSE",
        "MINERVINI_VCP_BREAKOUT",
        "STOCKBEE_EP_MOMENTUM_BURST",
        "STOCKBEE_EXHAUSTION_HAMMER",
        "PARABOLIC_EXHAUSTION_SHORT",
        "OVERNIGHT_24X5_IBKR"
    ],
    group=grp_omni
)
i_use_mkt_reg = input.bool(true, "Enforce Causal Multi-Feed Market Regime", group=grp_omni)
i_vix_def     = input.float(25.0, "VIX Crash-Defensive Threshold", minval=15.0, maxval=60.0, step=0.5, group=grp_omni)
i_mkt_sym     = input.symbol("AMEX:SPY", "Broad Market Regime Feed", group=grp_omni)
i_qqq_sym     = input.symbol("NASDAQ:QQQ", "Growth / Nasdaq Regime Feed", group=grp_omni)
i_semi_sym    = input.symbol("NASDAQ:SOXX", "Semiconductor Regime Feed", group=grp_omni)
i_rsp_sym     = input.symbol("AMEX:RSP", "Equal-Weight Breadth Feed", group=grp_omni)
i_vix_sym     = input.symbol("CBOE:VIX", "Volatility Regime Feed (VIX)", group=grp_omni)

// ── 2. Lossless Trailing, Auto-Reverse & Re-Entry FSM Controls ──────────────
grp_fsm = "02 · Lossless Trailing, Auto-Reverse & Re-Entry"
i_sched_ovr     = input.string("AUTO_NATR", "Trailing Schedule Override", options=["AUTO_NATR", "tight_near_lossless", "baseline", "wide_natr_adaptive"], group=grp_fsm)
i_fee_bps_side  = input.float(4.0, "Est Fee/Slippage (bps/side)", minval=0.0, maxval=25.0, step=0.5, group=grp_fsm)
i_spread_bps    = input.float(2.0, "Spread Buffer (bps)", minval=0.0, maxval=20.0, step=0.5, group=grp_fsm)
i_fast_be_pct   = input.float(0.20, "Fast Lossless BE Trigger (%)", minval=0.10, maxval=1.00, step=0.05, group=grp_fsm)
i_prog_lock     = input.bool(true, "Enable 4-Tier Progressive R-Lock (+1R/+2R/+3R)", group=grp_fsm)
i_fast_sell_rev = input.bool(true, "Enable Fast-Sell Climax + Auto-Reverse Short", group=grp_fsm)
i_auto_reverse  = input.bool(true, "Enable Flatten-First Auto-Reverse", group=grp_fsm)
i_auto_reentry  = input.bool(true, "Enable Seamless Auto Re-Entry", group=grp_fsm)
i_cooldown_sec  = input.int(60, "Re-Entry Cooldown (sec)", minval=60, maxval=3600, step=60, group=grp_fsm)
i_show_rungs    = input.bool(true, "Plot Lossless BE + 1R/2R/3R Profit Rungs", group=grp_fsm)

// ── 3. Setup Signal Thresholds (Auto-Tuned by Omni Preset) ──────────────────
grp_sig = "03 · SOTA Setup Sensitivity & Visual HUD"
i_rvol_len    = input.int(20, "Relative Volume Lookback", minval=5, maxval=100, group=grp_sig)
i_rvol_base   = input.float(1.5, "Base Min RVOL", minval=1.0, maxval=10.0, step=0.1, group=grp_sig)
i_ext_mult    = input.float(2.0, "Extreme Move ATR Multiple", minval=1.0, maxval=5.0, step=0.25, group=grp_sig)
i_show_diag   = input.bool(true, "Show Institutional SOTA Status HUD", group=grp_sig)
i_show_mtf    = input.bool(true, "Show MTF (1m/5m/15m/D) Alignment Row", group=grp_sig)
i_show_bg     = input.bool(true, "Show Subtle Regime / VCP Background Tint", group=grp_sig)

// ── 4. Causal 24/5 America/New_York Session Classification ──────────────────
ny_hour   = hour(time_close, "America/New_York")
ny_min    = minute(time_close, "America/New_York")
ny_dow    = dayofweek(time_close, "America/New_York")
ny_mins   = ny_hour * 60 + ny_min

is_rth       = ny_mins >= 570 and ny_mins < 960
is_pre       = ny_mins >= 240 and ny_mins < 570
is_after     = ny_mins >= 960 and ny_mins < 1200
is_24x5_open = (ny_dow >= dayofweek.monday and ny_dow <= dayofweek.thursday) or (ny_dow == dayofweek.friday and ny_mins < 1200) or (ny_dow == dayofweek.sunday and ny_mins >= 1200)
is_ext       = is_pre or is_after

sess_label = not is_24x5_open ? "CLOSED" : is_rth ? "RTH" : is_pre ? "PRE_MARKET" : is_after ? "AFTER_HOURS" : "OVERNIGHT"
order_type = is_rth ? "STOP_MARKET" : "STOP_LIMIT"
collar_bps = is_rth ? 0 : is_ext ? 35 : 50

// ── 5. Reg-NMS Rule-612 Inward Tick Quantization (Exact Engine Parity) ──────
rule612_tick(float px) =>
    px >= 1.0 ? 0.01 : 0.0001

inward_stop(float px, int side) =>
    float tick = rule612_tick(px)
    float ticks = math.round(px / tick, 10)
    math.max(0.0001, math.round((side == 1 ? math.ceil(ticks) : math.floor(ticks)) * tick, 4))

hard_stop(float ref_px, int side, float cap) =>
    int ref_ticks = math.round(ref_px * 10000)
    int cap_bps = math.round(cap * 10000)
    int numerator = ref_ticks * (10000 - side * cap_bps)
    int raw_ticks = math.floor((numerator + (side == 1 ? 9999 : 0)) / 10000)
    int step_ticks = raw_ticks >= 10000 ? 100 : 1
    int inward_offset = side == 1 ? step_ticks - 1 : 0
    int stop_ticks = math.floor((raw_ticks + inward_offset) / step_ticks) * step_ticks
    int distance = side * (ref_ticks - stop_ticks)
    stop_ticks > 0 and distance > 0 and distance * 10000 <= cap_bps * ref_ticks ? stop_ticks / 10000.0 : na

// ── 6. Core Technicals & Wilder NATR Schedule Selection ─────────────────────
i_natr_len = 14
atr_val    = ta.atr(i_natr_len)
natr_pct   = close > 0 ? atr_val / close : 0.020
natr_out   = math.max(0.000001, math.round(natr_pct, 6))
vol_sma    = ta.sma(volume, i_rvol_len)
rvol       = vol_sma > 0 ? volume / vol_sma : 1.0
ema_fast   = ta.ema(close, 9)
ema_slow   = ta.ema(close, 21)
ema_50     = ta.ema(close, 50)
vwap_val   = ta.vwap(hlc3)

auto_sched   = natr_out <= 0.015 ? "tight_near_lossless" : natr_out <= 0.030 ? "baseline" : "wide_natr_adaptive"
preset_sched = i_omni_preset == "LOSSLESS_TIGHT_SCALP" or i_omni_preset == "OVERNIGHT_24X5_IBKR" ? "tight_near_lossless" : auto_sched
sched_id     = i_sched_ovr == "AUTO_NATR" ? preset_sched : i_sched_ovr

var string leg_schedule = ""
active_schedule = leg_schedule == "" ? sched_id : leg_schedule
is_tight = active_schedule == "tight_near_lossless"
is_base  = active_schedule == "baseline"

sess_init_cap = is_tight ? (is_rth ? 0.0150 : is_ext ? 0.0125 : 0.0100) : (is_rth ? 0.0200 : is_ext ? 0.0150 : 0.0100)
be_trig_base  = is_tight ? (is_rth ? 0.0025 : is_ext ? 0.0030 : 0.0025) : is_base ? (is_rth ? 0.0040 : is_ext ? 0.0045 : 0.0030) : (is_rth ? 0.0060 : is_ext ? 0.0055 : 0.0040)
be_trig       = math.min(be_trig_base, i_fast_be_pct / 100.0)
min_trail_pct = is_tight ? (is_rth ? 0.0020 : is_ext ? 0.0030 : 0.0040) : is_base ? (is_rth ? 0.0030 : is_ext ? 0.0045 : 0.0055) : (is_rth ? 0.0045 : is_ext ? 0.0050 : 0.0060)
natr_mult     = is_tight ? (is_rth ? 1.00 : is_ext ? 1.25 : 1.50) : is_base ? (is_rth ? 1.25 : is_ext ? 1.50 : 1.75) : (is_rth ? 1.50 : is_ext ? 1.50 : 1.75)
trail_pct     = math.min(sess_init_cap, math.max(min_trail_pct, natr_pct * natr_mult))
fee_buf       = (i_fee_bps_side * 2.0 + i_spread_bps) / 10000.0

// ── 7. Multi-Feed Causal Market-Status & Inverse-ETF Pair Engine ────────────
tkr = str.upper(syminfo.ticker)
is_inverse_etf = tkr == "SOXS" or tkr == "SQQQ" or tkr == "SPXS" or tkr == "SPXU" or tkr == "SH" or tkr == "SDOW" or tkr == "TZA" or tkr == "QID" or tkr == "SDS"
is_soxs        = tkr == "SOXS"
is_soxl        = tkr == "SOXL"
is_semi_sym    = is_soxs or is_soxl or tkr == "NVDA" or tkr == "SMH" or tkr == "SOXX" or tkr == "MU" or tkr == "AMD" or tkr == "AVGO" or tkr == "TSM" or tkr == "ASML" or tkr == "MRVL"
is_qqq_sym     = tkr == "TQQQ" or tkr == "SQQQ" or tkr == "QQQ" or tkr == "QID"
bench_sym      = is_semi_sym ? i_semi_sym : is_qqq_sym ? i_qqq_sym : i_mkt_sym

[mkt_c, mkt_sma, mkt_vwap, mkt_roc, mkt_close_ts] = request.security(
    ticker.modify(bench_sym, session=session.extended),
    timeframe.period,
    [close, ta.sma(close, 50), ta.vwap(hlc3), (close - close[15]) / math.max(close[15], syminfo.mintick), time_close],
    gaps=barmerge.gaps_off,
    lookahead=barmerge.lookahead_off
)
[spy_c, spy_sma] = request.security(ticker.modify(i_mkt_sym, session=session.extended), "5", [close, ta.sma(close, 50)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[rsp_c, rsp_sma] = request.security(i_rsp_sym, "D", [close, ta.sma(close, 20)], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
vix_last         = request.security(i_vix_sym, "15", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

mtf_5m_up  = request.security(syminfo.tickerid, "5",  close > ta.ema(close, 21), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
mtf_15m_up = request.security(syminfo.tickerid, "15", close > ta.ema(close, 21), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
mtf_d_up   = request.security(syminfo.tickerid, "D",  close > ta.sma(close, 50), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

mkt_bull     = not na(mkt_c) and not na(mkt_sma) and not na(mkt_vwap) and mkt_c > mkt_sma and mkt_c > mkt_vwap and mkt_roc >= 0.002
mkt_crash    = not na(mkt_c) and not na(mkt_sma) and not na(mkt_vwap) and mkt_c < mkt_sma and mkt_c < mkt_vwap and mkt_roc <= -0.003
vix_stressed = not na(vix_last) and vix_last >= i_vix_def
breadth_weak = not na(rsp_c) and not na(rsp_sma) and rsp_c < rsp_sma
spy_weak     = not na(spy_c) and not na(spy_sma) and spy_c < spy_sma

raw_regime = (mkt_crash or (vix_stressed and spy_weak)) ? -1 : mkt_bull ? 1 : 0
eff_regime = not i_use_mkt_reg ? 0 : is_inverse_etf ? -raw_regime : raw_regime

resolved_mode = i_omni_preset != "AUTO_REGIME_ADAPTIVE" ? i_omni_preset : (not is_rth and not is_ext ? "OVERNIGHT_24X5_IBKR" : raw_regime == -1 ? "CRASH_DEFENSIVE_INVERSE" : raw_regime == 1 ? "MINERVINI_VCP_BREAKOUT" : "LOSSLESS_TIGHT_SCALP")
rvol_min = resolved_mode == "STOCKBEE_EP_MOMENTUM_BURST" ? math.max(i_rvol_base, 2.5) : resolved_mode == "CRASH_DEFENSIVE_INVERSE" ? math.max(i_rvol_base, 1.8) : i_rvol_base

// ── 8. Full SOTA Setup Library (VCP, EP Burst, Hammer, Hidden Vol, Parabolic) ─
bar_range = high - low
clv       = bar_range > 0 ? (2.0 * close - high - low) / bar_range : 0.0
lower_wk  = math.min(open, close) - low
atr_5     = ta.atr(5)
vol_5     = ta.sma(volume, 5)
coil_ok   = atr_val > 0 and (atr_5 / atr_val) <= 0.70
vdu_ok    = vol_sma > 0 and (vol_5 / vol_sma) <= 0.70
hi_20     = ta.highest(high, 20)[1]
hi_10     = ta.highest(high, 10)[1]
lo_10     = ta.lowest(low, 10)[1]
prev_lo5  = ta.lowest(low, 5)[1]
bar_chg   = close[1] > 0 ? (close - close[1]) / close[1] : 0.0

is_extreme        = atr_val > 0 and bar_range >= atr_val * i_ext_mult and rvol >= rvol_min
hidden_vol_bull   = barstate.isconfirmed and rvol >= 2.0 and bar_range < atr_val * 0.85 and clv >= 0.60
hidden_vol_bear   = barstate.isconfirmed and rvol >= 2.0 and bar_range < atr_val * 0.85 and clv <= -0.60
vcp_coil          = barstate.isconfirmed and not na(hi_20) and close >= hi_20 * 0.85 and coil_ok and vdu_ok
vcp_breakout      = barstate.isconfirmed and not na(hi_20) and close > hi_20 and rvol >= rvol_min and clv >= 0.25 and (coil_ok[1] or vdu_ok[1])
ep_momentum_burst = barstate.isconfirmed and bar_chg >= 0.015 and bar_range >= atr_val * 1.6 and rvol >= 2.5 and clv >= 0.55 and close > ema_fast
exhaustion_hammer = barstate.isconfirmed and not na(prev_lo5) and low < prev_lo5 and close > prev_lo5 and bar_range > 0 and (lower_wk / bar_range) >= 0.55 and clv >= 0.45 and rvol >= 1.3
parabolic_top     = barstate.isconfirmed and not na(vwap_val) and close >= vwap_val * (1.0 + 2.0 * natr_out) and rvol >= 2.5

long_extreme_rev  = is_extreme[1] and close[1] < open[1] and low[1] <= lo_10 and close > open and close > ema_fast
long_vcp_ep       = vcp_breakout or ep_momentum_burst or (hidden_vol_bull and not na(vwap_val) and close > vwap_val and close > ema_fast)
long_by_mode  = resolved_mode == "MINERVINI_VCP_BREAKOUT" ? vcp_breakout : resolved_mode == "STOCKBEE_EP_MOMENTUM_BURST" ? (ep_momentum_burst or hidden_vol_bull) : resolved_mode == "STOCKBEE_EXHAUSTION_HAMMER" ? (exhaustion_hammer or long_extreme_rev) : resolved_mode == "PARABOLIC_EXHAUSTION_SHORT" ? false : resolved_mode == "CRASH_DEFENSIVE_INVERSE" ? ((is_inverse_etf and (long_vcp_ep or long_extreme_rev)) or (ep_momentum_burst and rvol >= 4.0)) : (long_extreme_rev or long_vcp_ep or exhaustion_hammer)

short_crash_align = eff_regime == -1 and not na(vwap_val) and close < vwap_val and close < ema_fast and close < open and rvol >= rvol_min
short_peak_rev    = eff_regime != 1 and not na(vwap_val[1]) and (parabolic_top[1] or (is_extreme[1] and close[1] > open[1] and high[1] >= hi_10 and close[1] >= vwap_val[1] * (1.0 + natr_out))) and close < open and (close < low[1] or (not na(vwap_val) and close < vwap_val))
short_by_mode     = resolved_mode == "PARABOLIC_EXHAUSTION_SHORT" ? short_peak_rev : (resolved_mode == "MINERVINI_VCP_BREAKOUT" or resolved_mode == "STOCKBEE_EXHAUSTION_HAMMER") ? short_peak_rev : (short_crash_align or short_peak_rev)

long_rev_raw  = barstate.isconfirmed and is_24x5_open and (eff_regime != -1 or (ep_momentum_burst and rvol >= 4.0)) and long_by_mode
short_rev_raw = barstate.isconfirmed and is_24x5_open and short_by_mode

setup_archetype = ep_momentum_burst ? "EARLY_EP_MOMENTUM_BURST" : vcp_breakout ? "VCP_BREAKOUT" : hidden_vol_bull ? "HIDDEN_VOL_ACCUM" : parabolic_top ? "PARABOLIC_TOP" : short_crash_align ? "CRASH_ALIGNMENT" : short_peak_rev ? "PEAK_REVERSAL" : vcp_coil ? "VCP_COIL" : "EXTREME_REVERSAL"

// ── 9. Stateful Monotonic Lossless Trailing, Auto-Reverse & Re-Entry FSM ────
var int   pos_dir         = 0
var float entry_px        = na
var float init_stop_px    = na
var float stop_px         = na
var float best_px         = na
var bool  be_armed        = false
var int   lock_tier       = 0
var int   pending_rev_dir = 0
var int   last_exit_ts    = na
var int   last_exit_dir   = 0
var bool  did_reverse     = false

bool entered_long  = false
bool entered_short = false
bool exited_stop   = false
bool exited_rev    = false

standard_minute  = chart.is_standard and timeframe.isminutes and timeframe.multiplier == 1
benchmark_ready  = mkt_close_ts == time_close and not na(mkt_c) and not na(mkt_sma) and not na(mkt_vwap) and not na(mkt_roc)
practice_ready   = not i_use_mkt_reg or benchmark_ready
signal_dir       = not practice_ready or long_rev_raw == short_rev_raw ? 0 : long_rev_raw ? 1 : -1
fast_sell_climax = barstate.isconfirmed and is_24x5_open and i_fast_sell_rev and eff_regime != 1 and (parabolic_top or (close < open and close < ema_fast and close < low[1] and not na(vwap_val) and (close < vwap_val or high[1] >= vwap_val[1] * (1.0 + natr_out)) and rvol >= math.max(1.2, rvol_min * 0.7)))

if barstate.isconfirmed and is_24x5_open and pos_dir != 0
    bool stop_touched   = pos_dir == 1 ? low <= stop_px : high >= stop_px
    bool climax_flip    = pos_dir == 1 and fast_sell_climax
    bool opp_sig        = i_auto_reverse and (signal_dir == -pos_dir or climax_flip)
    bool retire         = stop_touched or opp_sig
    if not retire
        best_px := pos_dir == 1 ? math.max(best_px, high) : math.min(best_px, low)
        float hard = hard_stop(entry_px, pos_dir, sess_init_cap)
        if na(hard)
            retire := true
        else
            float next_stop = pos_dir == 1 ? math.max(stop_px, hard) : math.min(stop_px, hard)
            float fav_move  = pos_dir * (best_px - entry_px) / entry_px
            float leg_risk  = not na(init_stop_px) ? math.max(syminfo.mintick, math.abs(entry_px - init_stop_px)) : na
            float r_mult    = not na(leg_risk) ? pos_dir * (best_px - entry_px) / leg_risk : 0.0
            if fav_move >= be_trig and not na(trail_pct)
                be_armed  := true
                lock_tier := math.max(lock_tier, 1)
                float raw_be  = math.max(0.0001, entry_px * (1.0 + pos_dir * fee_buf))
                float be_stop = inward_stop(raw_be, pos_dir)
                if pos_dir * (best_px - raw_be) > 0 and pos_dir * (best_px - be_stop) > 0
                    next_stop := pos_dir == 1 ? math.max(next_stop, be_stop) : math.min(next_stop, be_stop)
                float eff_trail_pct = trail_pct
                if i_prog_lock and not na(leg_risk)
                    if r_mult >= 3.0 or (parabolic_top and pos_dir == 1 and r_mult >= 1.5)
                        lock_tier     := math.max(lock_tier, 4)
                        eff_trail_pct := math.max(0.0010, trail_pct * 0.25)
                        float lock3 = inward_stop(math.max(0.0001, entry_px + pos_dir * 2.35 * leg_risk), pos_dir)
                        if pos_dir * (best_px - lock3) > 0
                            next_stop := pos_dir == 1 ? math.max(next_stop, lock3) : math.min(next_stop, lock3)
                    else if r_mult >= 2.0
                        lock_tier     := math.max(lock_tier, 3)
                        eff_trail_pct := math.max(0.0012, trail_pct * 0.40)
                        float lock2 = inward_stop(math.max(0.0001, entry_px + pos_dir * 1.35 * leg_risk), pos_dir)
                        if pos_dir * (best_px - lock2) > 0
                            next_stop := pos_dir == 1 ? math.max(next_stop, lock2) : math.min(next_stop, lock2)
                    else if r_mult >= 1.0
                        lock_tier     := math.max(lock_tier, 2)
                        eff_trail_pct := math.max(0.0015, trail_pct * 0.65)
                        float lock1 = inward_stop(math.max(0.0001, entry_px + pos_dir * 0.45 * leg_risk), pos_dir)
                        if pos_dir * (best_px - lock1) > 0
                            next_stop := pos_dir == 1 ? math.max(next_stop, lock1) : math.min(next_stop, lock1)
                float trail_stop = inward_stop(best_px * (1.0 - pos_dir * eff_trail_pct), pos_dir)
                if pos_dir * (best_px - trail_stop) <= 0
                    float tick = pos_dir == 1 and best_px <= 1.0 ? 0.0001 : rule612_tick(best_px)
                    trail_stop := inward_stop(math.max(0.0001, best_px - pos_dir * tick), pos_dir)
                if pos_dir * (best_px - trail_stop) > 0
                    next_stop := pos_dir == 1 ? math.max(next_stop, trail_stop) : math.min(next_stop, trail_stop)
            retire := pos_dir * (close - next_stop) <= 0
            if not retire
                stop_px := next_stop
    if retire
        int rev_target  = (opp_sig and not stop_touched) ? (climax_flip ? -1 : signal_dir) : (fast_sell_climax and pos_dir == 1 and i_auto_reverse ? -1 : 0)
        pending_rev_dir := rev_target
        exited_stop     := stop_touched
        exited_rev      := opp_sig and not stop_touched
        last_exit_dir   := pos_dir
        last_exit_ts    := time_close
        pos_dir         := 0
        entry_px        := na
        init_stop_px    := na
        stop_px         := na
        best_px         := na
        be_armed        := false
        lock_tier       := 0
        leg_schedule    := ""

later_bar   = na(last_exit_ts) or time_close > last_exit_ts
cooldown_ok = na(last_exit_ts) or time_close - last_exit_ts >= i_cooldown_sec * 1000
eff_signal  = pending_rev_dir != 0 ? pending_rev_dir : signal_dir
reentry_ok  = eff_signal != last_exit_dir or (i_auto_reentry and cooldown_ok) or pending_rev_dir != 0
if barstate.isconfirmed and is_24x5_open and pos_dir == 0 and eff_signal != 0 and later_bar and reentry_ok and not na(natr_out)
    pending_rev_dir := 0
    float trigger = math.round(close, 4)
    float initial = hard_stop(trigger, eff_signal, sess_init_cap)
    if not na(initial)
        did_reverse   := last_exit_dir != 0 and eff_signal == -last_exit_dir
        pos_dir       := eff_signal
        entry_px      := trigger
        init_stop_px  := initial
        best_px       := trigger
        stop_px       := initial
        be_armed      := false
        lock_tier     := 0
        leg_schedule  := sched_id
        entered_long  := pos_dir == 1
        entered_short := pos_dir == -1
else if barstate.isconfirmed and later_bar and pending_rev_dir != 0
    pending_rev_dir := 0

// Compute Lossless BE & R-Multiple Rungs for active display leg
risk_r   = pos_dir != 0 and not na(entry_px) and not na(init_stop_px) ? math.abs(entry_px - init_stop_px) : na
be_floor = pos_dir != 0 and not na(entry_px) ? inward_stop(math.max(0.0001, entry_px * (1.0 + pos_dir * fee_buf)), pos_dir) : na
rung_1r  = pos_dir != 0 and not na(risk_r) ? entry_px + pos_dir * risk_r : na
rung_2r  = pos_dir != 0 and not na(risk_r) ? entry_px + pos_dir * 2.0 * risk_r : na
rung_3r  = pos_dir != 0 and not na(risk_r) ? entry_px + pos_dir * 3.0 * risk_r : na

// ── 10. Visual Overlays, Lossless Stop & Profit-Lock Rungs ──────────────────
plot(ema_fast, "EMA 9",  color=color.new(color.teal, 20), linewidth=1)
plot(ema_slow, "EMA 21", color=color.new(color.orange, 30), linewidth=1)
plot(ema_50,   "EMA 50", color=color.new(color.purple, 55), linewidth=1)
plot(vwap_val, "Session VWAP", color=color.new(color.blue, 25), linewidth=2)

stop_col = be_armed ? color.new(color.lime, 0) : color.new(color.red, 0)
plot(pos_dir != 0 ? stop_px : na, "Lossless Monotonic Stop", color=stop_col, style=plot.style_linebr, linewidth=2)
plot(i_show_rungs and pos_dir != 0 ? be_floor : na, "BE+Fee Floor", color=color.new(color.yellow, 35), style=plot.style_linebr, linewidth=1)
plot(i_show_rungs and pos_dir != 0 ? rung_1r  : na, "+1R Target",   color=color.new(color.aqua, 55), style=plot.style_linebr, linewidth=1)
plot(i_show_rungs and pos_dir != 0 ? rung_2r  : na, "+2R Target",   color=color.new(color.lime, 55), style=plot.style_linebr, linewidth=1)
plot(i_show_rungs and pos_dir != 0 ? rung_3r  : na, "+3R Target",   color=color.new(color.rgb(16, 185, 129), 45), style=plot.style_linebr, linewidth=1)

plotshape(entered_long,  title="Long Entry / Re-Entry",  style=shape.triangleup,   location=location.belowbar, color=color.lime,    size=size.small)
plotshape(entered_short, title="Short Entry / Crash",    style=shape.triangledown, location=location.abovebar, color=color.fuchsia, size=size.small)
plotshape(exited_rev,    title="Auto-Reverse Flatten",   style=shape.flag,         location=location.abovebar, color=color.orange,  size=size.tiny)
plotshape(ep_momentum_burst, title="EP / 4% Momentum Burst", style=shape.diamond,  location=location.belowbar, color=color.yellow,  size=size.small)
plotshape(vcp_breakout and not entered_long, title="VCP Breakout", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.tiny)
plotshape(exhaustion_hammer, title="Exhaustion Hammer",  style=shape.labelup,      location=location.belowbar, color=color.new(color.teal, 20), text="H", textcolor=color.white, size=size.tiny)
plotshape(hidden_vol_bull, title="Hidden Vol Accum",     style=shape.circle,       location=location.belowbar, color=color.new(color.green, 15), size=size.tiny)
plotshape(hidden_vol_bear, title="Hidden Vol Distrib",   style=shape.circle,       location=location.abovebar, color=color.new(color.maroon, 15), size=size.tiny)
plotshape(parabolic_top,   title="Parabolic Top",        style=shape.xcross,       location=location.abovebar, color=color.yellow, size=size.tiny)

bgcolor(i_show_bg ? (eff_regime == -1 ? color.new(color.red, 92) : vcp_coil ? color.new(color.aqua, 94) : na) : na, title="Regime / VCP Tint")

// ── 11. Institutional SOTA Status & Market-Tuned HUD (Top-Right) ────────────
var table hud = table.new(position.top_right, 2, 11, border_width=1, border_color=color.new(color.gray, 55))
if barstate.islast and i_show_diag
    pair_mode = is_inverse_etf ? "INVERSE_HEDGE" : is_soxl ? "SOXL_BULL_3X" : is_semi_sym ? "SEMI_LEADER" : "EQUITY_BROAD"
    reg_txt   = raw_regime == 1 ? "RISK-ON (+1)" : raw_regime == -1 ? "CRASH DEF (-1)" : "NEUTRAL (0)"
    vix_txt   = na(vix_last) ? "N/A" : str.tostring(vix_last, "0.00")
    br_txt    = breadth_weak ? "WEAK (RSP<20D)" : "OK (RSP>=20D)"
    mtf_txt   = (close > ema_slow ? "1m▲ " : "1m▼ ") + (mtf_5m_up ? "5m▲ " : "5m▼ ") + (mtf_15m_up ? "15m▲ " : "15m▼ ") + (mtf_d_up ? "D▲" : "D▼")
    tier_tag  = lock_tier >= 4 ? " [T4 FAST-SELL]" : lock_tier == 3 ? " [T3 +2R LOCK]" : lock_tier == 2 ? " [T2 +1R LOCK]" : be_armed ? " [T1 BE+]" : " [HARD CAP]"
    stop_txt  = na(stop_px) ? "Flat (Cap " + str.tostring(sess_init_cap * 100.0, "0.00") + "%)" : str.tostring(stop_px, "0.####") + tier_tag

    table.cell(hud, 0, 0,  "Omni Preset",   bgcolor=color.new(color.navy, 35), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0,  resolved_mode,   bgcolor=color.new(color.navy, 55), text_color=color.aqua,  text_size=size.small)
    table.cell(hud, 0, 1,  "Market Status", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1,  reg_txt + " | VIX " + vix_txt, bgcolor=raw_regime == -1 ? color.new(color.red, 55) : raw_regime == 1 ? color.new(color.green, 65) : color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 2,  "Breadth/Bench", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2,  br_txt + " [" + bench_sym + "]", bgcolor=breadth_weak ? color.new(color.orange, 65) : color.new(color.green, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 3,  "24/5 Session",  bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3,  sess_label + " · " + order_type + " (" + str.tostring(collar_bps, "0") + "bp)", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 4,  "Lossless Sched",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4,  active_schedule + " (NATR " + str.tostring(natr_out * 100.0, "0.00") + "%)", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 5,  "Trail / BE Arm",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 5,  "BE " + str.tostring(be_trig * 100.0, "0.00") + "% · Trail " + str.tostring(trail_pct * 100.0, "0.00") + "%", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 6,  "Active Stop",   bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 6,  stop_txt,        bgcolor=be_armed ? color.new(color.green, 65) : color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 7,  "Pair / Mode",   bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 7,  pair_mode + " (eff=" + str.tostring(eff_regime) + ")", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 8,  "Setup / RVOL",  bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 8,  setup_archetype + " (" + str.tostring(rvol, "0.00") + "x)", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    if i_show_mtf
        table.cell(hud, 0, 9, "MTF Trend",  bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
        table.cell(hud, 1, 9, mtf_txt,      bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(hud, 0, 10, "Auto-Rev/Gate", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    gate_txt = "Rev=" + str.tostring(i_auto_reverse) + (did_reverse ? " [FLIP]" : "") + " Re=" + str.tostring(i_auto_reentry) + " · qty=1 (display-only)"
    table.cell(hud, 1, 10, gate_txt,        bgcolor=color.new(color.orange, 70), text_color=color.white, text_size=size.small)

// ── 12. Strict Schema-Compatible tier0.tv-alert.v1 Payload Emitter ──────────
emit_alert_json(string sig_side, float trig_px, float stp_px) =>
    (
        "{\"schema_version\":\"tier0.tv-alert.v1\"" +
        ",\"symbol\":\"" + tkr + "\"" +
        ",\"ts_utc_ms\":" + str.tostring(time_close, "0") +
        ",\"bar_confirmed\":true" +
        ",\"side\":\"" + sig_side + "\"" +
        ",\"qty\":1" +
        ",\"session\":\"" + sess_label + "\"" +
        ",\"order_type\":\"" + order_type + "\"" +
        ",\"trigger_price\":" + str.tostring(trig_px, "0.####") +
        ",\"stop_price\":" + str.tostring(stp_px, "0.####") +
        ",\"limit_collar_bps\":" + str.tostring(collar_bps, "0") +
        ",\"trailing_schedule\":\"" + active_schedule + "\"" +
        ",\"natr_pct\":" + str.tostring(natr_out, "0.######") +
        ",\"auto_reverse\":" + str.tostring(i_auto_reverse) +
        ",\"auto_reentry\":" + str.tostring(i_auto_reentry) +
        ",\"reentry_cooldown_secs\":" + str.tostring(i_cooldown_sec, "0") +
        ",\"strategy_id\":\"SignalExecutionStrategy\"" +
        ",\"semi_auto_confirmed\":false" +
        ",\"setup_archetype\":\"" + setup_archetype + "\"" +
        ",\"macro_regime\":" + str.tostring(eff_regime, "0") +
        ",\"rvol\":" + str.tostring(rvol, "0.##") +
        ",\"is_leveraged_or_inverse\":" + str.tostring(is_inverse_etf or is_soxl or tkr == "TQQQ") +
        ",\"data_source\":\"tradingview_pine_v6\"}"
    )

if entered_long and standard_minute
    alert(emit_alert_json("BUY", entry_px, stop_px), alert.freq_once_per_bar_close)
if entered_short and standard_minute
    alert(emit_alert_json("SELL", entry_px, stop_px), alert.freq_once_per_bar_close)
