//@version=6
indicator("Tier-0 Unusual Volume Buildup & Darkpool Proxy", shorttitle="T0_DP_UV", overlay=false, max_bars_back=500)

// ============================================================================
// Tier-0 SOTA — Dedicated Pane-2 Unusual Volume Buildup & Institutional Darkpool Proxy
// Non-Repainting: barstate.isconfirmed + gaps=barmerge.gaps_off + lookahead=barmerge.lookahead_off
// Pairs with: scanner.py FINRA TRF (Exchange D) darkpool_trf_ratio & vol_buildup_ratio
// Proxy Signals: RVOL Z-Score, 3-Bar Volume Velocity Ramp, Effort-vs-Result Hidden Volume
//                Ratio (HVR), VWAP-Pin Absorption Crosses, and Session CVD Divergence
// ============================================================================

grp_uv = "01 · Unusual Volume & Velocity Thresholds"
i_len       = input.int(20, "Volume Baseline Lookback", minval=5, maxval=100, group=grp_uv)
i_rvol_hi   = input.float(1.8, "Unusual Volume RVOL Threshold", minval=1.1, maxval=10.0, step=0.1, group=grp_uv)
i_z_thresh  = input.float(2.0, "RVOL Z-Score Anomaly Threshold", minval=1.0, maxval=6.0, step=0.25, group=grp_uv)
i_vel_min   = input.float(1.8, "3-Bar Volume Velocity Ramp Min", minval=1.1, maxval=5.0, step=0.1, group=grp_uv)
i_dvol_min  = input.float(5.0, "Institutional Liquidity Gate ($M)", minval=0.5, maxval=100.0, step=0.5, group=grp_uv)

grp_dp = "02 · Darkpool / Hidden-Volume Proxy Settings"
i_hvr_min   = input.float(2.0, "Hidden-Volume Absorption Ratio (HVR) Min", minval=1.0, maxval=10.0, step=0.25, group=grp_dp)
i_rng_cap   = input.float(0.85, "Absorption Max Bar-Range / ATR", minval=0.25, maxval=1.50, step=0.05, group=grp_dp)
i_vwap_atr  = input.float(0.35, "VWAP-Pin Max Distance (ATR Mult)", minval=0.10, maxval=1.00, step=0.05, group=grp_dp)
i_show_hvr  = input.bool(true, "Plot Hidden-Volume Ratio (HVR, Clamped 0-10)", group=grp_dp)
i_show_z    = input.bool(false, "Plot RVOL Z-Score Line", group=grp_dp)
i_show_hud  = input.bool(true, "Show Volume & Darkpool Proxy HUD (Top-Right)", group=grp_dp)

// ── Core Volume, Velocity & MTF Confirmation (Non-Repainting) ───────────────
int htf_idx = barstate.isrealtime ? 1 : 0
[v5_cur, v5_sma] = request.security(
    syminfo.tickerid,
    "5",
    [nz(volume[htf_idx], 0.0), ta.sma(nz(volume, 0.0), i_len)[htf_idx]],
    gaps=barmerge.gaps_off,
    lookahead=barmerge.lookahead_off
)
rvol_5m = not na(v5_sma) and v5_sma > 0 ? v5_cur / v5_sma : 1.0

vol_safe   = nz(volume, 0.0)
vol_sma    = ta.sma(vol_safe, i_len)
vol_std    = ta.stdev(vol_safe, i_len)
rvol       = vol_sma > 0 ? vol_safe / vol_sma : 1.0
vol_zscore = vol_std > 0 ? (vol_safe - vol_sma) / vol_std : 0.0
vol_3      = ta.sma(vol_safe, 3)
vol_buildup_ratio = vol_sma > 0 ? math.max(0.0, math.round(vol_3 / vol_sma, 3)) : 1.0

dollar_vol   = close * vol_safe
dollar_vol_m = dollar_vol / 1000000.0
var float day_dvol = 0.0
if timeframe.change("D")
    day_dvol := 0.0
day_dvol += dollar_vol
day_dvol_m = day_dvol / 1000000.0
liq_ok     = day_dvol_m >= i_dvol_min

// ── Darkpool / Institutional Hidden-Volume Absorption Proxy ─────────────────
atr_14    = ta.atr(14)
vwap_val  = ta.vwap(hlc3)
bar_range = high - low
clv       = bar_range > 0 ? (2.0 * close - high - low) / bar_range : 0.0

// Session Buying/Selling Pressure (Cumulative Volume Delta Proxy)
var float sess_cvd = 0.0
if timeframe.change("D")
    sess_cvd := 0.0
sess_cvd += vol_safe * clv
cvd_ema   = ta.ema(sess_cvd, 9)

lo_5 = ta.lowest(low, 5)[1]
hi_5 = ta.highest(high, 5)[1]
cvd_bull_div = barstate.isconfirmed and not na(lo_5) and low <= lo_5 and sess_cvd > nz(sess_cvd[5], sess_cvd) and clv >= 0.20
cvd_bear_div = barstate.isconfirmed and not na(hi_5) and high >= hi_5 and sess_cvd < nz(sess_cvd[5], sess_cvd) and clv <= -0.20

// Effort-vs-Result Hidden Volume Ratio (exact parity with tier0_omni_sota_24x5.pine)
hidden_vol_ratio = math.max(0.0, math.round(nz(rvol / math.max(0.25, bar_range / math.max(nz(atr_14, syminfo.mintick), syminfo.mintick)), 0.0), 2))
vwap_pin_absorb  = barstate.isconfirmed and not na(vwap_val) and atr_14 > 0 and math.abs(close - vwap_val) <= atr_14 * i_vwap_atr and rvol >= i_rvol_hi and bar_range < atr_14 * i_rng_cap

uv_ramp          = barstate.isconfirmed and ((rvol >= i_rvol_hi and vol_safe > nz(volume[1], 0.0) and nz(volume[1], 0.0) >= vol_sma) or (vol_zscore >= i_z_thresh and vol_buildup_ratio >= i_vel_min))
dp_absorb_bull   = barstate.isconfirmed and rvol >= 2.0 and bar_range < atr_14 * i_rng_cap and hidden_vol_ratio >= i_hvr_min and (clv >= 0.55 or (vwap_pin_absorb and clv >= 0.20 and sess_cvd >= cvd_ema))
dp_distrib_bear  = barstate.isconfirmed and rvol >= 2.0 and bar_range < atr_14 * i_rng_cap and hidden_vol_ratio >= i_hvr_min and (clv <= -0.55 or (vwap_pin_absorb and clv <= -0.20 and sess_cvd < cvd_ema))
climax_spike     = barstate.isconfirmed and vol_zscore >= 3.0 and rvol >= 3.0

// ── Pane-2 Visualizations ───────────────────────────────────────────────────
hist_col = dp_absorb_bull ? color.lime : dp_distrib_bear ? color.maroon : climax_spike ? color.yellow : uv_ramp ? color.aqua : rvol >= i_rvol_hi ? color.teal : color.new(color.gray, 55)

plot(math.min(10.0, rvol), "RVOL (Clamped 0-10x)", color=hist_col, style=plot.style_histogram, linewidth=3)
plot(math.min(10.0, vol_buildup_ratio), "3-Bar Volume Velocity (VBR)", color=color.orange, linewidth=2)
plot(i_show_hvr ? math.min(10.0, hidden_vol_ratio) : na, "Hidden-Volume Ratio (HVR)", color=color.fuchsia, linewidth=1)
plot(i_show_z ? math.max(-2.0, math.min(10.0, vol_zscore)) : na, "RVOL Z-Score", color=color.white, linewidth=1)

hline(1.0, "1.0x Baseline",  color=color.new(color.gray, 65),   linestyle=hline.style_dotted)
hline(1.8, "1.8x UV Ramp",   color=color.new(color.aqua, 55),   linestyle=hline.style_dashed)
hline(3.0, "3.0x EP Climax", color=color.new(color.yellow, 55), linestyle=hline.style_dashed)

plotshape(vwap_pin_absorb, title="VWAP-Pin Darkpool Proxy", style=shape.diamond,      location=location.top,    color=color.aqua,   size=size.tiny)
plotshape(dp_absorb_bull,  title="Darkpool Bull Absorb",    style=shape.triangleup,   location=location.bottom, color=color.lime,   size=size.tiny)
plotshape(dp_distrib_bear, title="Darkpool Bear Distrib",   style=shape.triangledown, location=location.top,    color=color.red,    size=size.tiny)
plotshape(cvd_bull_div,    title="CVD Bullish Divergence",  style=shape.circle,       location=location.bottom, color=color.green,  size=size.tiny)
plotshape(cvd_bear_div,    title="CVD Bearish Divergence",  style=shape.circle,       location=location.top,    color=color.maroon, size=size.tiny)

// ── Institutional Volume & Darkpool Proxy HUD (Top-Right) ───────────────────
var table vhud = table.new(position.top_right, 2, 8, border_width=1, border_color=color.new(color.gray, 55))
if barstate.islast and i_show_hud
    string state_lbl = dp_absorb_bull ? "DARKPOOL ABSORB (+)" : dp_distrib_bear ? "DARKPOOL DISTRIB (-)" : vwap_pin_absorb ? "VWAP-PIN CROSS" : climax_spike ? "CLIMAX VOL SPIKE" : uv_ramp ? "UV VELOCITY RAMP" : "NORMAL FLOW"
    color state_bg   = dp_absorb_bull ? color.new(color.green, 50) : dp_distrib_bear ? color.new(color.maroon, 45) : vwap_pin_absorb ? color.new(color.teal, 45) : climax_spike ? color.new(color.olive, 45) : uv_ramp ? color.new(color.navy, 45) : color.new(color.gray, 80)
    string cvd_txt   = cvd_bull_div ? "BULL DIV (+)" : cvd_bear_div ? "BEAR DIV (-)" : sess_cvd >= cvd_ema ? "ACCUM (+)" : "DISTRIB (-)"

    table.cell(vhud, 0, 0, "Flow / Proxy",  bgcolor=color.new(color.navy, 35), text_color=color.white, text_size=size.small)
    table.cell(vhud, 1, 0, state_lbl,       bgcolor=state_bg,                  text_color=color.white, text_size=size.small)
    table.cell(vhud, 0, 1, "RVOL (1m / 5m)",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(vhud, 1, 1, str.tostring(rvol, "0.00") + "x  |  5m " + str.tostring(rvol_5m, "0.00") + "x", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(vhud, 0, 2, "RVOL Z-Score",  bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(vhud, 1, 2, str.tostring(vol_zscore, "0.00") + "s" + (vol_zscore >= i_z_thresh ? " [ANOMALY]" : ""), bgcolor=vol_zscore >= i_z_thresh ? color.new(color.teal, 55) : color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(vhud, 0, 3, "3-Bar Velocity",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(vhud, 1, 3, str.tostring(vol_buildup_ratio, "0.00") + "x" + (vol_buildup_ratio >= i_vel_min ? " [RAMP]" : ""), bgcolor=vol_buildup_ratio >= i_vel_min ? color.new(color.orange, 60) : color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(vhud, 0, 4, "Hidden Vol HVR",bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(vhud, 1, 4, str.tostring(hidden_vol_ratio, "0.00") + (hidden_vol_ratio >= i_hvr_min ? " [ABSORB]" : ""), bgcolor=hidden_vol_ratio >= i_hvr_min ? color.new(color.purple, 55) : color.new(color.gray, 85), text_color=color.white, text_size=size.small)
    table.cell(vhud, 0, 5, "Dollar Vol",    bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(vhud, 1, 5, "Bar $" + str.tostring(dollar_vol_m, "0.00") + "M | Day $" + str.tostring(day_dvol_m, "0.0") + "M " + (liq_ok ? "[OK]" : "[THIN]"), bgcolor=liq_ok ? color.new(color.green, 75) : color.new(color.orange, 65), text_color=color.white, text_size=size.small)
    table.cell(vhud, 0, 6, "Session CVD",   bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(vhud, 1, 6, cvd_txt,         bgcolor=sess_cvd >= cvd_ema ? color.new(color.green, 70) : color.new(color.maroon, 65), text_color=color.white, text_size=size.small)
    table.cell(vhud, 0, 7, "TRF Sync Note", bgcolor=color.new(color.gray, 75), text_color=color.white, text_size=size.small)
    table.cell(vhud, 1, 7, "Chart Proxy · Pair w/ Scanner FINRA TRF", bgcolor=color.new(color.gray, 85), text_color=color.silver, text_size=size.small)

// ── Non-Repainting Alert Conditions ─────────────────────────────────────────
alertcondition(uv_ramp,         title="Tier-0 UV Velocity Ramp",            message="T0_DP_UV Unusual Volume Ramp confirmed on {{ticker}} @ {{close}}")
alertcondition(dp_absorb_bull,  title="Tier-0 Darkpool Bull Absorption",    message="T0_DP_UV Hidden-Volume Bull Absorption on {{ticker}} @ {{close}}")
alertcondition(dp_distrib_bear, title="Tier-0 Darkpool Bear Distribution",  message="T0_DP_UV Hidden-Volume Bear Distribution on {{ticker}} @ {{close}}")
alertcondition(vwap_pin_absorb, title="Tier-0 VWAP-Pin Darkpool Proxy",     message="T0_DP_UV VWAP-Pin Darkpool Absorption Proxy on {{ticker}} @ {{close}}")
alertcondition(cvd_bull_div,    title="Tier-0 CVD Bullish Divergence",      message="T0_DP_UV CVD Bullish Accumulation Divergence on {{ticker}} @ {{close}}")
alertcondition(cvd_bear_div,    title="Tier-0 CVD Bearish Divergence",      message="T0_DP_UV CVD Bearish Distribution Divergence on {{ticker}} @ {{close}}")
