{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "mcpServers": {
    "codebase-memory": {
      "command": "codebase-memory-mcp",
      "args": []
    },
    "xerj": {
      "command": "xerj",
      "args": [
        "mcp"
      ],
      "env": {
        "XERJ_URL": "http://127.0.0.1:9200",
        "XERJ_DISABLE_FEEDBACK": "true"
      }
    },
    "nautilus-engine": {
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "python",
        "scripts/nautilus_mcp_server.py"
      ]
    },
    "edgartools": {
      "command": "uv",
      "args": [
        "run",
        "--no-sync",
        "edgartools-mcp"
      ]
    }
  }
}
